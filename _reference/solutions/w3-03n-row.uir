%v   = buffer 3 dtype=i32 slot=0
%B   = buffer 6 dtype=i32 slot=1
%out = buffer 2 dtype=i32 slot=2
%j   = range 2
%ov  = shrink %out %j []
%z   = store %ov 0
%out0 = after %out %z
%k   = range 3
%vv  = shrink %v %k []
%x   = load %vv
%k2  = mul %k 2
%kj  = add %k2 %j
%bv  = shrink %B %kj []
%y   = load %bv
%p   = mul %x %y
%ov0 = shrink %out0 %j []
%cur = load %ov0
%sum = add %cur %p
%s   = store %ov0 %sum
%ek  = end %s %k
%ej  = end %ek %j
%out1 = after %out %ej
