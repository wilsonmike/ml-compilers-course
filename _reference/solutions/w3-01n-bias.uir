%g    = buffer 6 dtype=i32 slot=0
%bias = buffer 3 dtype=i32 slot=1
%out  = buffer 6 dtype=i32 slot=2
%i    = range 2
%j    = range 3
%i3   = mul %i 3
%o    = add %i3 %j
%gv   = shrink %g %o []
%x    = load %gv
%bv   = shrink %bias %j []
%y    = load %bv
%sum  = add %x %y
%ov   = shrink %out %o []
%s    = store %ov %sum
%ej   = end %s %j
%ei   = end %ej %i
%out1 = after %out %ei
