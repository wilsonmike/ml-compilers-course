%x  = buffer 5 dtype=f32 slot=0
%ab = buffer 2 dtype=f32 slot=1
%y  = buffer 5 dtype=f32 slot=2
%av = shrink %ab 0 shape=[]
%a  = load %av
%bv = shrink %ab 1 shape=[]
%b  = load %bv
%v  = load %x
%ea = expand %a shape=[5]
%eb = expand %b shape=[5]
%m  = mul %v %ea
%r  = add %m %eb
%s  = store %y %r
%y1 = after %y %s
