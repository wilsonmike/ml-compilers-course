%xb = buffer 5 dtype=f32 slot=0
%wb = buffer 2 dtype=f32 slot=1
%yb = buffer 4 dtype=f32 slot=2
%x  = load %xb
%w  = load %wb
%s0 = shrink %x 0 [4]
%s1 = shrink %x 1 [4]
%win = stack %s0 %s1
%w2 = reshape %w [2 1]
%wx = expand %w2 [2 4]
%pr = mul %win %wx
%y  = reduce %pr op=add pop=1
%st = store %yb %y
%y1 = after %yb %st
