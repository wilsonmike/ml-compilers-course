%Ab = buffer 6 dtype=f32 slot=0
%vb = buffer 3 dtype=f32 slot=1
%yb = buffer 2 dtype=f32 slot=2
%A  = load %Ab
%v  = load %vb
%a2 = reshape %A [2 3]
%aT = permute %a2 [1 0]
%v2 = reshape %v [3 1]
%vx = expand %v2 [3 2]
%p  = mul %aT %vx
%y  = reduce %p op=add pop=1
%s  = store %yb %y
%y1 = after %yb %s
