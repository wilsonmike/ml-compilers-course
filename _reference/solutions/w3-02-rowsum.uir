%A   = buffer 12 dtype=i32 slot=0
%out = buffer 3 dtype=i32 slot=1
%i   = range 3
%o   = shrink %out %i shape=[]
%z   = store %o 0
%out0 = after %out %z
%j   = range 4
%i4  = mul %i 4
%ij  = add %i4 %j
%av  = shrink %A %ij shape=[]
%a   = load %av
%o0  = shrink %out0 %i shape=[]
%cur = load %o0
%sum = add %cur %a
%s   = store %o0 %sum
%ej  = end %s %j
%ei  = end %ej %i
%out1 = after %out %ei
