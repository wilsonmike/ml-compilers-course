%b  = buffer 3 dtype=i32 slot=0 data=[1 2 3]
%e0 = shrink %b 0 shape=[]
%e1 = shrink %b 1 shape=[]
%e2 = shrink %b 2 shape=[]
%a  = load %e0
%c  = load %e1
%n1 = add %a %c
%s1 = store %e1 %n1
%b1 = after %b %s1
%d  = load %e2
%n2 = add %n1 %d
%f2 = shrink %b1 2 shape=[]
%s2 = store %f2 %n2
%b2 = after %b1 %s2
