%x  = buffer 6 dtype=f32 slot=0
%w  = buffer 3 dtype=f32 slot=1
%y  = buffer 6 dtype=f32 slot=2
%i  = range 6
%yv = shrink %y %i shape=[]
%z  = store %yv 0.0
%y0 = after %y %z
%k  = range 3
%ik = add %i %k
%j  = add %ik -1
%lo = cmplt %j 0
%hi = cmplt %j 6
%ok = where %lo false %hi
%jp = max %j 0
%jm = mod %jp 6
%xv = shrink %x %jm shape=[]
%xe = load %xv
%xz = where %ok %xe 0.0
%wv = shrink %w %k shape=[]
%we = load %wv
%p  = mul %xz %we
%yv0 = shrink %y0 %i shape=[]
%cur = load %yv0
%sum = add %cur %p
%s  = store %yv0 %sum
%ek = end %s %k
%ei = end %ek %i
%y1 = after %y %ei
