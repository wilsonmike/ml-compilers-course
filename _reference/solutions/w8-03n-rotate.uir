%x = buffer 16 dtype=f32 slot=0
%o = buffer 16 dtype=f32 slot=1
%sh = alloc 4 dtype=f32
%b = range 4 axis=global
%m = mul %b 4
%t = range 4 axis=local
%i = add %m %t
%xv = shrink %x %i []
%xe = load %xv
%sv = shrink %sh %t []
%s1 = store %sv %xe
%e1 = end %s1 %t
%sh1 = after %sh %e1
%u = range 4 axis=local
%a = add %u 1
%r = mod %a 4
%rv = shrink %sh1 %r []
%re = load %rv
%j = add %m %u
%ov = shrink %o %j []
%s2 = store %ov %re
%e2 = end %s2 %u
%eb = end %e1 %e2 %b
%o1 = after %o %eb
