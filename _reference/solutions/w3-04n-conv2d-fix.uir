%x  = buffer 16 dtype=i32 slot=0
%w  = buffer 4 dtype=i32 slot=1
%y  = buffer 9 dtype=i32 slot=2
%oi = range 3
%oj = range 3
%o3 = mul %oi 3
%yo = add %o3 %oj
%yv = shrink %y %yo []
%z  = store %yv 0
%y0 = after %y %z
%ki = range 2
%kj = range 2
%r  = add %oi %ki
%c  = add %oj %kj
%r4 = mul %r 4
%xo = add %r4 %c
%xv = shrink %x %xo []
%xe = load %xv
%k2 = mul %ki 2
%wo = add %k2 %kj
%wv = shrink %w %wo []
%we = load %wv
%p  = mul %xe %we
%yv0 = shrink %y0 %yo []
%cur = load %yv0
%sum = add %cur %p
%s  = store %yv0 %sum
%e1 = end %s %kj
%e2 = end %e1 %ki
%e3 = end %e2 %oj
%e4 = end %e3 %oi
%y1 = after %y %e4
