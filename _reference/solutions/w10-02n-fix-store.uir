%x  = buffer 32 dtype=i32 slot=0
%o  = buffer 32 dtype=i32 slot=1
%d  = range 4 axis=device
%b  = range 2 axis=global
%t  = range 4 axis=local
%ds = mul %d 8
%m  = mul %b 4
%e  = add %m %t
%i  = add %ds %e
%xv = shrink %x %i []
%xe = load %xv
%y2 = mul %xe 2
%y  = add %y2 1
%ov = shrink %o %i []
%s  = store %ov %y
%et = end %s %t
%eb = end %et %b
%ed = end %eb %d
%o1 = after %o %ed
