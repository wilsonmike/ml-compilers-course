%a   = buffer 4 dtype=i32 slot=0
%b   = buffer 4 dtype=i32 slot=1
%out = buffer 1 dtype=i32 slot=2
%o   = shrink %out 0 shape=[]
%z   = store %o 0
%out1 = after %out %z
%k   = range 4
%av  = shrink %a %k shape=[]
%x   = load %av
%bv  = shrink %b %k shape=[]
%y   = load %bv
%p   = mul %x %y
%o1  = shrink %out1 0 shape=[]
%cur = load %o1
%sum = add %cur %p
%s   = store %o1 %sum
%e   = end %s %k
%out2 = after %out1 %e
