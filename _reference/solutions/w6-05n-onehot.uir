%ys  = buffer 4 dtype=i32 slot=0
%oh  = buffer 12 dtype=f32 slot=1
%cls = buffer 3 [0 1 2] dtype=i32 slot=2
%y   = load %ys
%yl  = reshape %y [4 1]
%ye  = expand %yl [4 3]
%c   = load %cls
%cl  = reshape %c [1 3]
%ce  = expand %cl [4 3]
%q   = cmpeq %ye %ce
%f   = cast %q dtype=f32
%ff  = reshape %f [12]
%st  = store %oh %ff
%oh1 = after %oh %st
