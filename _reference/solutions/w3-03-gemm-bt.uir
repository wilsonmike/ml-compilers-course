%A   = buffer 6 dtype=i32 slot=0
%B   = buffer 6 dtype=i32 slot=1
%C   = buffer 4 dtype=i32 slot=2
%i   = range 2
%j   = range 2
%i2  = mul %i 2
%ij  = add %i2 %j
%cv  = shrink %C %ij shape=[]
%z   = store %cv 0
%C0  = after %C %z
%k   = range 3
%i3  = mul %i 3
%ik  = add %i3 %k
%av  = shrink %A %ik shape=[]
%a   = load %av
%j3  = mul %j 3
%jk  = add %j3 %k
%bv  = shrink %B %jk shape=[]
%b   = load %bv
%p   = mul %a %b
%cv0 = shrink %C0 %ij shape=[]
%cur = load %cv0
%sum = add %cur %p
%s   = store %cv0 %sum
%ek  = end %s %k
%ej  = end %ek %j
%ei  = end %ej %i
%C1  = after %C %ei
