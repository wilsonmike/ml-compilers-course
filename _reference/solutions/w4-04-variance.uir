%x  = buffer 8 dtype=f32 slot=0
%o  = buffer 1 dtype=f32 slot=1
%v  = load %x
%s  = reduce %v op=add
%m  = mul %s 0.125
%nm = mul %m -1.0
%e  = expand %nm shape=[8]
%c  = add %v %e
%sq = mul %c %c
%t  = reduce %sq op=add
%var = mul %t 0.125
%ov = shrink %o 0 shape=[]
%st = store %ov %var
%o1 = after %o %st
