%Ab = buffer 4 dtype=f32 slot=0
%Bb = buffer 4 dtype=f32 slot=1
%Cb = buffer 4 dtype=f32 slot=2
%A  = load %Ab
%B  = load %Bb
%a3 = reshape %A [2 2 1]
%aT = permute %a3 [1 0 2]
%ax = expand %aT [2 2 2]
%b3 = reshape %B [2 1 2]
%bx = expand %b3 [2 2 2]
%p  = mul %ax %bx
%c  = reduce %p op=add pop=1
%cf = reshape %c [4]
%s  = store %Cb %cf
%C1 = after %Cb %s
