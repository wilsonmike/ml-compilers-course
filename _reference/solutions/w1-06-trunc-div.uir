%a = param [] slot=0 dtype=i32 addrspace=ALU
%b = param [] slot=1 dtype=i32 addrspace=ALU
%q = div %a %b
%r = mod %a %b
%rneg = cmplt %r 0
%rpos = cmplt 0 %r
%nz = xor %rneg %rpos
%aneg = cmplt %a 0
%bneg = cmplt %b 0
%opp = xor %aneg %bneg
%fix = where %nz %opp false
%q1 = add %q 1
%out = where %fix %q1 %q
