%in   = buffer 4 dtype=i32 slot=0
%out  = buffer 1 dtype=i32 slot=1
%acc  = alloc 1 dtype=i32
%a    = shrink %acc 0 []
%k    = range 4
%cur  = load %a
%iv   = shrink %in %k []
%x    = load %iv
%sum  = add %cur %x
%s    = store %a %sum
%e    = end %s %k
%acc1 = after %acc %e
%a1   = shrink %acc1 0 []
%tot  = load %a1
%o    = shrink %out 0 []
%so   = store %o %tot
%out1 = after %out %so
