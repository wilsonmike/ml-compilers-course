%in  = buffer 5 dtype=f32 slot=0
%out = buffer 1 dtype=f32 slot=1
%o   = shrink %out 0 shape=[]
%z   = store %o -inf
%out0 = after %out %z
%o0  = shrink %out0 0 shape=[]
%k   = range 5
%v   = shrink %in %k shape=[]
%x   = load %v
%cur = load %o0
%m   = max %cur %x
%s   = store %o0 %m
%e   = end %s %k
%out1 = after %out %e
