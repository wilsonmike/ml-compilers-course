%d   = buffer 8 [1 2 3 4 10 20 30 40] dtype=i32 slot=0
%ix  = buffer 1 [2] dtype=i32 slot=1
%res = buffer 1 dtype=i32 slot=2
%i0  = shrink %ix 0 []
%i   = load %i0
%k   = mod %i 4
%a0  = shrink %d %k []
%a   = load %a0
%o   = add %k 4
%b0  = shrink %d %o []
%b   = load %b0
%v   = add %a %b
%r0  = shrink %res 0 []
%s   = store %r0 %v
%r1  = after %res %s
