%a  = buffer 6 dtype=f32 slot=0
%b  = buffer 6 dtype=f32 slot=1
%o  = buffer 6 dtype=f32 slot=2
%va = load %a
%vb = load %b
%A  = reshape %va [2 3]
%B  = reshape %vb [3 2]
%C  = matmul %A %B
%f  = reshape %C [4]
%L  = reduce %f op=add
%g  = gradient %L %A
%gf = reshape %g [6]
%st = store %o %gf
%o1 = after %o %st
