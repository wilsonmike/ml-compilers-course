%x  = buffer 12 dtype=i32 slot=0
%o  = buffer 12 dtype=i32 slot=1
%d  = range 3 axis=device
%b  = range 1 axis=global
%t  = range 4 axis=local
%ds = mul %d 4
%m  = mul %b 4
%e  = add %m %t
%i  = add %ds %e
%xv = shrink %x %i []
%xe = load %xv
%r  = sub 11 %i
%rv = shrink %x %r []
%re = load %rv
%y  = add %xe %re
%ov = shrink %o %i []
%s  = store %ov %y
%et = end %s %t
%eb = end %et %b
%ed = end %eb %d
%o1 = after %o %ed
