%a   = buffer 4 dtype=i32 slot=0
%b   = buffer 4 dtype=i32 slot=1
%out = buffer 1 dtype=i32 slot=2
%acc  = alloc 1 dtype=i32
%t    = shrink %acc 0 []
%k    = range 4
%av   = shrink %a %k []
%x    = load %av
%bv   = shrink %b %k []
%y    = load %bv
%p    = mul %x %y
%cur  = load %t
%sum  = add %cur %p
%s    = store %t %sum
%e    = end %s %k
%acc1 = after %acc %e
%t1   = shrink %acc1 0 []
%tot  = load %t1
%o    = shrink %out 0 []
%so   = store %o %tot
%out1 = after %out %so
