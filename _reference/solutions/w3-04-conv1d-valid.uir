%x  = buffer 6 dtype=i32 slot=0
%w  = buffer 3 dtype=i32 slot=1
%y  = buffer 4 dtype=i32 slot=2
%i  = range 4
%yv = shrink %y %i shape=[]
%z  = store %yv 0
%y0 = after %y %z
%k  = range 3
%ik = add %i %k
%xv = shrink %x %ik shape=[]
%xe = load %xv
%wv = shrink %w %k shape=[]
%we = load %wv
%p  = mul %xe %we
%yv0 = shrink %y0 %i shape=[]
%cur = load %yv0
%sum = add %cur %p
%s  = store %yv0 %sum
%ek = end %s %k
%ei = end %ek %i
%y1 = after %y %ei
