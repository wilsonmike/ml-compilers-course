%a  = buffer 4 dtype=f32 slot=0
%b  = buffer 4 dtype=f32 slot=1
%o  = buffer 4 dtype=f32 slot=2
%va = load %a
%vb = load %b
%A  = reshape %va [2 2]
%B  = reshape %vb [2 2]
%C  = matmul %A %B
%f  = reshape %C [4]
%L  = reduce %f op=add
%g  = gradient %L %B
%gf = reshape %g [4]
%st = store %o %gf
%o1 = after %o %st
