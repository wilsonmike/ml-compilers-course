# render
# transpose via permute, stored flat
%v0 = buffer 15 dtype=i32 slot=0 data=[8 -2 -1 -7 8 -2 -1 0 7 -5 -2 2 5 3 -4]
%v1 = load %v0
%v2 = reshape %v1 shape=[3 5]
%v3 = permute %v2 order=[1 0]
%v4 = buffer 15 dtype=i32 slot=1
%v5 = reshape %v3 shape=[15]
%v6 = store %v4 %v5
%v7 = after %v4 %v6
