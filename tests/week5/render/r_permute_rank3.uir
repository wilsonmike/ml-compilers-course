# render
# a rank-3 permute
%v0 = buffer 24 dtype=i32 slot=0 data=[-6 5 6 7 -9 1 -3 3 -4 -9 1 9 -6 -3 0 9 -9 8 6 4 -2 -1 0 9]
%v1 = load %v0
%v2 = reshape %v1 shape=[2 3 4]
%v3 = permute %v2 order=[2 0 1]
%v4 = buffer 24 dtype=i32 slot=1
%v5 = reshape %v3 shape=[24]
%v6 = store %v4 %v5
%v7 = after %v4 %v6
