# render
# a run-time but provable offset: mod (max o 0) 4 with o = 13 is 1
%v0 = buffer 8 dtype=i32 slot=0 data=[-4 -5 -3 3 -4 3 -3 4]
%v1 = load %v0
%v2 = buffer 1 dtype=i32 slot=9 data=[13]
%v3 = shrink %v2 0 shape=[]
%v4 = load %v3
%v5 = max %v4 0
%v6 = mod %v5 4
%v7 = shrink %v1 %v6 shape=[4]
%v8 = buffer 4 dtype=i32 slot=1
%v9 = store %v8 %v7
%v10 = after %v8 %v9
