# render
# stack of matrices rendered as a where chain
%v0 = buffer 6 dtype=i32 slot=0 data=[-3 8 0 1 5 4]
%v1 = load %v0
%v2 = reshape %v1 shape=[2 3]
%v3 = buffer 6 dtype=i32 slot=1 data=[-7 -2 -8 -8 4 9]
%v4 = load %v3
%v5 = reshape %v4 shape=[2 3]
%v6 = stack %v2 %v5
%v7 = buffer 12 dtype=i32 slot=2
%v8 = reshape %v6 shape=[12]
%v9 = store %v7 %v8
%v10 = after %v7 %v9
