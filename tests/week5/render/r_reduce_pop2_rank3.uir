# render
# reduce the two leading axes of a rank-3 value
%v0 = buffer 60 dtype=i32 slot=0 data=[3 -3 2 -1 4 1 -3 -6 -5 -6 0 -9 9 0 -3 0 3 -7 0 7 1 0 8 -5 -7 -7 7 0 -7 4 -3 4 3 -5 2 -5 7 -6 2 1 -7 4 3 -2 3 6 -6 0 -3 9 -6 2 5 -3 -1 -4 6 8 -2 2]
%v1 = load %v0
%v2 = reshape %v1 shape=[3 4 5]
%v3 = reduce %v2 op=max pop=2
%v4 = buffer 5 dtype=i32 slot=1
%v5 = store %v4 %v3
%v6 = after %v4 %v5
