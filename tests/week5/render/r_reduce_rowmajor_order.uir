# render
# row-major fold order is visible in f32 bits
%v0 = buffer 4 dtype=f32 slot=0 data=[100000000.0 1.0 -100000000.0 1.0]
%v1 = load %v0
%v2 = reshape %v1 shape=[2 2]
%v3 = reduce %v2 op=add pop=2
%v4 = buffer 1 dtype=f32 slot=1
%v5 = reshape %v3 shape=[1]
%v6 = store %v4 %v5
%v7 = after %v4 %v6
