# render
# reduce over an axis that expand created: every copy is still added, so the result is 4 times x
%x   = buffer 6 [1.0 -2.0 0.5 3.0 -1.5 2.25] dtype=f32 slot=0
%o   = buffer 6 dtype=f32 slot=1
%v   = load %x
%r   = reshape %v [3 2 1]
%e   = expand %r [3 2 4]
%p   = permute %e [2 0 1]
%red = reduce %p op=add
%f   = reshape %red [6]
%s   = store %o %f
%o1  = after %o %s
