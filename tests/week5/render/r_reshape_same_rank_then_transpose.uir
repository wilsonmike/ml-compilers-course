# render
# reshape [2 3] to [3 2] is not a no-op: transposing afterwards shows the new row boundaries
%v0 = buffer 6 dtype=i32 slot=0 data=[-1 7 -8 -9 -6 -8]
%v1 = load %v0
%v2 = reshape %v1 shape=[2 3]
%v3 = reshape %v2 shape=[3 2]
%v4 = permute %v3 order=[1 0]
%v5 = buffer 6 dtype=i32 slot=1
%v6 = reshape %v4 shape=[6]
%v7 = store %v5 %v6
%v8 = after %v5 %v7
