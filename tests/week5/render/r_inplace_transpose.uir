# render
# transpose a 3x3 matrix in place: the result is built from the old contents, not half-overwritten ones
%b = buffer 9 dtype=i32 slot=0 data=[1 2 3 4 5 6 7 8 9]
%x = load %b
%m = reshape %x shape=[3 3]
%t = permute %m order=[1 0]
%f = reshape %t shape=[9]
%st = store %b %f
%b1 = after %b %st
