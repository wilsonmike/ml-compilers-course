# stack of vectors is [3 4]; index pops leading axes
%v0  = buffer 4 dtype=i32 slot=0 data=[-5 7 -4 -3]
%v1  = load %v0
%v2  = buffer 4 dtype=i32 slot=1 data=[2 6 0 -7]
%v3  = load %v2
%v4  = buffer 4 dtype=i32 slot=2 data=[4 -4 9 7]
%v5  = load %v4
%v6  = stack %v1 %v3 %v5
%v15 = index %v6 2 3
%v16 = 7
%v17 = assert %v15 %v16
