# pad then shrink back recovers the original, and an off-center window sees the zeros
%Xb   = buffer 6 [1 2 3 4 5 6] dtype=i32 slot=0
%x    = load %Xb
%x2   = reshape %x [2 3]
%p    = pad %x2 [1 1 1 1]
%win  = shrink %p 0 0 [2 2]
%w    = reshape %win [4]
%want = stack 0 0 0 1
%t1   = assert %w %want
