# expect: pass
# pad then shrink back recovers the original, and an off-center window sees the zeros
%Xb = buffer 6 dtype=i32 slot=0 data=[1 2 3 4 5 6]
%Yb = buffer 20 dtype=i32 slot=1
%x  = load %Xb
%x2 = reshape %x shape=[2 3]
%p  = pad %x2 pads=[1 1 1 1]
%pf = reshape %p shape=[20]
%s  = store %Yb %pf
%Y1 = after %Yb %s
%back = shrink %p 1 1 shape=[2 3]
%t0 = assert %back %x2
%win = shrink %p 0 0 shape=[2 2]
%w = reshape %win shape=[4]
%want = stack 0 0 0 1
%t1 = assert %w %want
