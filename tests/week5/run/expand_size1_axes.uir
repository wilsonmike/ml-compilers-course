# expect: pass
# only size-1 axes grow, and they repeat the single element
%v0 = buffer 3 dtype=i32 slot=0 data=[0 7 2]
%v1 = load %v0
%v2 = reshape %v1 shape=[3 1]
%v3 = expand %v2 shape=[3 4]
%v4 = buffer 12 dtype=i32 slot=1 data=[0 0 0 0 7 7 7 7 2 2 2 2]
%v5 = load %v4
%v6 = reshape %v5 shape=[3 4]
%v7 = assert %v3 %v6
%v8 = buffer 4 dtype=i32 slot=2 data=[2 -1 2 4]
%v9 = load %v8
%v10 = reshape %v9 shape=[1 4]
%v11 = expand %v10 shape=[3 4]
%v12 = buffer 12 dtype=i32 slot=3 data=[2 -1 2 4 2 -1 2 4 2 -1 2 4]
%v13 = load %v12
%v14 = reshape %v13 shape=[3 4]
%v15 = assert %v11 %v14
