# a loaded index could be anything, so indexing with it can't be proven safe
%v0  = buffer 4 [4 0 8 -1] dtype=i32 slot=0
%v1  = load %v0
%v2  = reshape %v1 [2 2]
%v6  = stack %v2 %v2
%v11 = buffer 1 [1] dtype=i32 slot=8
%v12 = shrink %v11 0 []
%v13 = load %v12
%v14 = index %v6 %v13 0
%t   = assert %v14 [4 0]
