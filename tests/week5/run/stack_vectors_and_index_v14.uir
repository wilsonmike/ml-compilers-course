# stack of vectors is [3 4]; index pops leading axes
%v0  = buffer 4 [-5 7 -4 -3] dtype=i32 slot=0
%v1  = load %v0
%v2  = buffer 4 [2 6 0 -7] dtype=i32 slot=1
%v3  = load %v2
%v4  = buffer 4 [4 -4 9 7] dtype=i32 slot=2
%v5  = load %v4
%v6  = stack %v1 %v3 %v5
%v11 = index %v6 1
%v14 = assert %v11 [2 6 0 -7]
