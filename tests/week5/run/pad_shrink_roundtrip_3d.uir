# expect: pass
# shrinking a pad at its left pads recovers the value
%v0 = buffer 12 dtype=i32 slot=0 data=[8 3 -8 -2 2 -1 5 4 -5 -8 -8 6]
%v1 = load %v0
%v2 = reshape %v1 shape=[2 3 2]
%v3 = pad %v2 pads=[1 2 0 1 3 0]
%v4 = shrink %v3 1 0 3 shape=[2 3 2]
%v5 = buffer 12 dtype=i32 slot=1 data=[8 3 -8 -2 2 -1 5 4 -5 -8 -8 6]
%v6 = load %v5
%v7 = reshape %v6 shape=[2 3 2]
%v8 = assert %v4 %v7
