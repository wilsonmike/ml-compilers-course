# reduce over rows, reshape to [1 4], expand back, add: the normalization shape
%v0  = buffer 12 [6 6 2 2 -8 -5 0 -5 9 7 0 8] dtype=i32 slot=0
%v1  = load %v0
%v2  = reshape %v1 [3 4]
%v3  = reduce %v2 op=add pop=1
%v4  = reshape %v3 [1 4]
%v5  = expand %v4 [3 4]
%v6  = add %v2 %v5
%v10 = assert %v6 [[13 14 4 7] [-1 3 2 0] [16 15 2 13]]
