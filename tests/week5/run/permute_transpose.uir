# expect: pass
# permute [2 3] with order [1 0] is the transpose
%v0 = buffer 6 dtype=i32 slot=0 data=[-3 4 -1 -4 3 -4]
%v1 = load %v0
%v2 = reshape %v1 shape=[2 3]
%v3 = permute %v2 order=[1 0]
%v4 = buffer 6 dtype=i32 slot=1 data=[-3 -4 4 3 -1 -4]
%v5 = load %v4
%v6 = reshape %v5 shape=[3 2]
%v7 = assert %v3 %v6
