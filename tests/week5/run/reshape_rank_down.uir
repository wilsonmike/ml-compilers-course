# expect: pass
# reshape a rank-3 value flat keeps row-major order
%v0 = buffer 12 dtype=i32 slot=0 data=[-1 2 7 -9 5 -2 -8 -4 -6 2 6 -2]
%v1 = load %v0
%v2 = reshape %v1 shape=[2 3 2]
%v3 = reshape %v2 shape=[12]
%v4 = buffer 12 dtype=i32 slot=1 data=[-1 2 7 -9 5 -2 -8 -4 -6 2 6 -2]
%v5 = load %v4
%v6 = assert %v3 %v5
