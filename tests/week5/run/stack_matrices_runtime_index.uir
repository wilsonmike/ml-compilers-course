# stack of matrices is rank 3; a run-time index picks one matrix and row 0 of it. mod 2 proves the index fits
%v0  = buffer 4 dtype=i32 slot=0 data=[4 0 8 -1]
%v1  = load %v0
%v2  = reshape %v1 shape=[2 2]
%v3  = buffer 4 dtype=i32 slot=1 data=[-9 -3 -4 9]
%v4  = load %v3
%v5  = reshape %v4 shape=[2 2]
%v6  = stack %v2 %v5
%v11 = buffer 1 dtype=i32 slot=8 data=[1]
%v12 = shrink %v11 0 shape=[]
%v13 = load %v12
%k   = mod %v13 2
%v14 = index %v6 %k 0
%t   = assert %v14 [-9 -3]
