# expect: pass
# stack of matrices is rank 3; a run-time index picks one row
%v0 = buffer 4 dtype=i32 slot=0 data=[4 0 8 -1]
%v1 = load %v0
%v2 = reshape %v1 shape=[2 2]
%v3 = buffer 4 dtype=i32 slot=1 data=[-9 -3 -4 9]
%v4 = load %v3
%v5 = reshape %v4 shape=[2 2]
%v6 = stack %v2 %v5
%v7 = buffer 8 dtype=i32 slot=2 data=[4 0 8 -1 -9 -3 -4 9]
%v8 = load %v7
%v9 = reshape %v8 shape=[2 2 2]
%v10 = assert %v6 %v9
%v11 = buffer 1 dtype=i32 slot=8 data=[1]
%v12 = shrink %v11 0 shape=[]
%v13 = load %v12
%v14 = index %v6 %v13 0
%v15 = buffer 2 dtype=i32 slot=3 data=[-9 -3]
%v16 = load %v15
%v17 = assert %v14 %v16
