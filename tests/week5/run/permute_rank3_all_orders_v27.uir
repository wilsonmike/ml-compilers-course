# all six axis orders of a [2 3 4] value
%v0  = buffer 24 dtype=i32 slot=0 data=[-7 -5 5 -5 -5 -9 -9 -3 -3 -4 -4 0 1 -3 8 -3 -4 -3 3 0 -9 2 4 -4]
%v1  = load %v0
%v2  = reshape %v1 shape=[2 3 4]
%v23 = permute %v2 order=[2 0 1]
%v27 = assert %v23 [[[-7 -5 -3] [1 -4 -9]] [[-5 -9 -4] [-3 -3 2]] [[5 -9 -4] [8 3 4]] [[-5 -3 0] [-3 0 -4]]]
