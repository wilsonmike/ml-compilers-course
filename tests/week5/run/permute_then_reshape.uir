# expect: pass
# reshape after a transpose reads the transposed (row-major) order
%v0 = buffer 6 dtype=i32 slot=0 data=[5 -6 9 2 0 -8]
%v1 = load %v0
%v2 = reshape %v1 shape=[2 3]
%v3 = permute %v2 order=[1 0]
%v4 = reshape %v3 shape=[6]
%v5 = buffer 6 dtype=i32 slot=1 data=[5 2 -6 0 9 -8]
%v6 = load %v5
%v7 = assert %v4 %v6
