# order [1 2 0] then its inverse [2 0 1] gives x back
%v0 = buffer 24 [-8 -1 -9 2 3 -9 8 4 2 3 9 -9 5 -8 -4 -3 -6 -2 5 2 7 2 7 -1] dtype=i32 slot=0
%v1 = load %v0
%v2 = reshape %v1 [2 3 4]
%v3 = permute %v2 [1 2 0]
%v4 = permute %v3 [2 0 1]
%v8 = assert %v4 [[[-8 -1 -9 2] [3 -9 8 4] [2 3 9 -9]] [[5 -8 -4 -3] [-6 -2 5 2] [7 2 7 -1]]]
