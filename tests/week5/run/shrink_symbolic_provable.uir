# expect: pass
# mod (max o 0) 2 is in [0, 1], so a 3-wide window of 4 is provably in range (o = 5 gives 1)
%v0 = buffer 4 dtype=i32 slot=0 data=[-1 0 6 3]
%v1 = load %v0
%v2 = buffer 1 dtype=i32 slot=9 data=[5]
%v3 = shrink %v2 0 shape=[]
%v4 = load %v3
%v5 = max %v4 0
%v6 = mod %v5 2
%v7 = shrink %v1 %v6 shape=[3]
%v8 = buffer 3 dtype=i32 slot=1 data=[0 6 3]
%v9 = load %v8
%v10 = assert %v7 %v9
