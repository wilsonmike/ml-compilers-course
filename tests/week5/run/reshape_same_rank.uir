%v1 = load %v0
%v2 = reshape %v1 shape=[2 3]
%v3 = reshape %v2 shape=[3 2]
%v4 = buffer 6 dtype=i32 slot=1 data=[3 8 -6 9 -2 -9]
%v5 = load %v4
%v6 = reshape %v5 shape=[3 2]
%v7 = assert %v3 %v6
