# cuda copy: 512
# an 8x4 by 4x4 GEMM: each device makes 4 rows of C from its 4 rows of A, and every device needs all of B
%A    = buffer 32 [0.14280518889427185 -0.14222189784049988 0.15618260204792023 -0.5878035426139832 0.6266425251960754 0.6471777558326721 0.3069450557231903 -0.6795408725738525 0.0413387194275856 -0.3444543778896332 -0.5000066757202148 0.905633807182312 0.9931139945983887 -0.9108872413635254 0.7203220725059509 0.20638121664524078 -0.23678803443908691 -0.43276357650756836 0.34992969036102295 -0.08633770048618317 0.3717229664325714 0.32369264960289 -0.7340437173843384 0.5356756448745728 0.9648265242576599 0.9387763142585754 0.22665363550186157 -0.9114787578582764 -0.9918897151947021 -0.7320549488067627 0.8820045590400696 -0.394278883934021] dtype=f32 slot=0
%B    = buffer 16 [-0.26770880818367004 0.7963925004005432 -0.37127238512039185 0.09796436876058578 -0.12793809175491333 -0.8700116276741028 0.16909244656562805 0.6881358027458191 -0.6871621608734131 -0.5514020919799805 -0.17425958812236786 -0.9261502623558044 -0.006793002597987652 0.6359657049179077 0.3157818913459778 0.06696747243404388] dtype=f32 slot=1
%C    = buffer 32 dtype=f32 slot=2
%acc  = alloc 4 dtype=f32
%d    = range 2 axis=device
%b    = range 4 axis=global
%t    = range 4 axis=local
%k    = range 4
%ds   = mul %d 16
%br   = mul %b 4
%ao0  = add %ds %br
%ao   = add %ao0 %k
%av   = shrink %A %ao []
%a    = load %av
%bo0  = mul %k 4
%bo   = add %bo0 %t
%bv   = shrink %B %bo []
%bb   = load %bv
%cv   = shrink %acc %t []
%cur  = load %cv
%p    = mul %a %bb
%sum  = add %cur %p
%st   = store %cv %sum
%ek   = end %st %k
%et   = end %ek %t
%acc1 = after %acc %et
%u    = range 4 axis=local
%rv   = shrink %acc1 %u []
%res  = load %rv
%co0  = add %ds %br
%co   = add %co0 %u
%ov   = shrink %C %co []
%sc   = store %ov %res
%eu   = end %sc %u
%eb   = end %et %eu %b
%ed   = end %eb %d
%C1   = after %C %ed
