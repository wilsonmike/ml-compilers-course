# render
# three increments of the same element
%b  = buffer 1 dtype=i32 slot=0 data=[2147483646]
%e  = shrink %b 0 shape=[]
%x  = load %e
%y  = add %x 1
%s  = store %e %y
%b1 = after %b %s
%e1 = shrink %b1 0 shape=[]
%x1 = load %e1
%y1 = add %x1 1
%s1 = store %e1 %y1
%b2 = after %b1 %s1
%e2 = shrink %b2 0 shape=[]
%x2 = load %e2
%y2 = add %x2 1
%s2 = store %e2 %y2
%b3 = after %b2 %s2
