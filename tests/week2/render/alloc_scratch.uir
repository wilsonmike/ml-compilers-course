# render
# a local alloc holds an intermediate, and it starts as zeros
%a  = buffer 2 [3 4] dtype=i32 slot=0
%o  = buffer 3 dtype=i32 slot=1
%t  = alloc 2 dtype=i32
%e0 = shrink %a 0 []
%x  = load %e0
%x2 = mul %x %x
%t0 = shrink %t 0 []
%st = store %t0 %x2
%t1 = after %t %st
%v  = load %t1
%z  = load %t
%s  = shrink %o 0 [2]
%so = store %s %v
%o1 = after %o %so
%l  = shrink %o1 2 []
%zz = index %z 1
%s2 = store %l %zz
%o2 = after %o1 %s2
