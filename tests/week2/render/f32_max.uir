# render
# max with nan on either side and both signed-zero orders
%in  = buffer 5 dtype=f32 slot=0 data=[nan 1.0 -0.0 0.0 -2.5]
%out = buffer 7 dtype=f32 slot=1
%e0 = shrink %in 0 shape=[]
%x0 = load %e0
%e1 = shrink %in 1 shape=[]
%x1 = load %e1
%e2 = shrink %in 2 shape=[]
%x2 = load %e2
%e3 = shrink %in 3 shape=[]
%x3 = load %e3
%e4 = shrink %in 4 shape=[]
%x4 = load %e4
%r0 = max %x0 %x1
%o0 = shrink %out 0 shape=[]
%s0 = store %o0 %r0
%v0 = after %out %s0
%r1 = max %x1 %x0
%o1 = shrink %v0 1 shape=[]
%s1 = store %o1 %r1
%v1 = after %v0 %s1
%r2 = max %x2 %x3
%o2 = shrink %v1 2 shape=[]
%s2 = store %o2 %r2
%v2 = after %v1 %s2
%r3 = max %x3 %x2
%o3 = shrink %v2 3 shape=[]
%s3 = store %o3 %r3
%v3 = after %v2 %s3
%r4 = max %x2 %x2
%o4 = shrink %v3 4 shape=[]
%s4 = store %o4 %r4
%v4 = after %v3 %s4
%r5 = max %x4 %x1
%o5 = shrink %v4 5 shape=[]
%s5 = store %o5 %r5
%v5 = after %v4 %s5
%r6 = max %x1 %x4
%o6 = shrink %v5 6 shape=[]
%s6 = store %o6 %r6
%v6 = after %v5 %s6
