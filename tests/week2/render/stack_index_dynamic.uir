# render
# index a stack with a loaded index. mod 3 proves each index fits the stack
%ix = buffer 2 dtype=i32 slot=0 data=[2 -3]
%o  = buffer 2 dtype=i32 slot=1
%e0 = shrink %ix 0 shape=[]
%e1 = shrink %ix 1 shape=[]
%i  = load %e0
%j  = load %e1
%im = mod %i 3
%jm = mod %j 3
%v  = stack 100 200 300
%a  = index %v %im
%b  = index %v %jm
%w  = stack %a %b
%s  = store %o %w
%o1 = after %o %s
