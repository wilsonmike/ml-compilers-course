# render
# index a stack with a loaded index
%ix = buffer 2 dtype=i32 slot=0 data=[2 0]
%o  = buffer 2 dtype=i32 slot=1
%e0 = shrink %ix 0 shape=[]
%e1 = shrink %ix 1 shape=[]
%i  = load %e0
%j  = load %e1
%v  = stack 100 200 300
%a  = index %v %i
%b  = index %v %j
%w  = stack %a %b
%s  = store %o %w
%o1 = after %o %s
