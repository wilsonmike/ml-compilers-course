# render
# shl shifts by y mod 32: loaded amounts of 33, -1 and 32 are 1, 31 and 0
%in = buffer 3 dtype=i32 slot=0 data=[33 -1 32]
%o  = buffer 3 dtype=i32 slot=1
%v  = load %in
%a  = index %v 0
%b  = index %v 1
%c  = index %v 2
%x  = shl 1 %a
%y  = shl 1 %b
%z  = shl 5 %c
%w  = stack %x %y %z
%s  = store %o %w
%o1 = after %o %s
