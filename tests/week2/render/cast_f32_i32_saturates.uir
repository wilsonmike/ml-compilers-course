# render
# f32 to i32 truncates and saturates, and nan is 0: C's plain (int32_t) cast is undefined for most of these
%in = buffer 6 [nan inf -inf 3e9 -3e9 -2.7] dtype=f32 slot=0
%o  = buffer 6 dtype=i32 slot=1
%v  = load %in
%a  = index %v 0
%b  = index %v 1
%c  = index %v 2
%d  = index %v 3
%e  = index %v 4
%f  = index %v 5
%ca = cast %a dtype=i32
%cb = cast %b dtype=i32
%cc = cast %c dtype=i32
%cd = cast %d dtype=i32
%ce = cast %e dtype=i32
%cf = cast %f dtype=i32
%w  = stack %ca %cb %cc %cd %ce %cf
%s  = store %o %w
%o1 = after %o %s
