# render
# max, xor and a cmplt-driven where on i32 edges
%in  = buffer 3 dtype=i32 slot=0 data=[-2147483648 2147483647 -1]
%out = buffer 6 dtype=i32 slot=1
%e0 = shrink %in 0 shape=[]
%x0 = load %e0
%e1 = shrink %in 1 shape=[]
%x1 = load %e1
%e2 = shrink %in 2 shape=[]
%x2 = load %e2
%r0 = max %x0 %x1
%o0 = shrink %out 0 shape=[]
%s0 = store %o0 %r0
%v0 = after %out %s0
%r1 = max %x2 %x0
%o1 = shrink %v0 1 shape=[]
%s1 = store %o1 %r1
%v1 = after %v0 %s1
%r2 = xor %x1 %x2
%o2 = shrink %v1 2 shape=[]
%s2 = store %o2 %r2
%v2 = after %v1 %s2
%r3 = xor %x0 %x2
%o3 = shrink %v2 3 shape=[]
%s3 = store %o3 %r3
%v3 = after %v2 %s3
%c0 = cmplt %x0 %x1
%c1 = cmplt %x1 %x2
%r4 = where %c0 %x1 %x0
%o4 = shrink %v3 4 shape=[]
%s4 = store %o4 %r4
%v4 = after %v3 %s4
%r5 = where %c1 %x2 %x0
%o5 = shrink %v4 5 shape=[]
%s5 = store %o5 %r5
%v5 = after %v4 %s5
