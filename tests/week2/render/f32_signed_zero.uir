# render
# -0.0 survives where it should and doesn't where it shouldn't
%in  = buffer 4 [-0.0 0.0 1.0 -1.0] dtype=f32 slot=0
%out = buffer 6 dtype=f32 slot=1
%e0  = shrink %in 0 []
%x0  = load %e0
%e1  = shrink %in 1 []
%x1  = load %e1
%e2  = shrink %in 2 []
%x2  = load %e2
%e3  = shrink %in 3 []
%x3  = load %e3
%r0  = add %x0 %x1
%o0  = shrink %out 0 []
%s0  = store %o0 %r0
%v0  = after %out %s0
%r1  = add %x0 %x0
%o1  = shrink %v0 1 []
%s1  = store %o1 %r1
%v1  = after %v0 %s1
%r2  = mul %x1 %x3
%o2  = shrink %v1 2 []
%s2  = store %o2 %r2
%v2  = after %v1 %s2
%r3  = mul %x0 %x2
%o3  = shrink %v2 3 []
%s3  = store %o3 %r3
%v3  = after %v2 %s3
%r4  = add %x0 -0.0
%o4  = shrink %v3 4 []
%s4  = store %o4 %r4
%v4  = after %v3 %s4
%r5  = mul %x0 %x3
%o5  = shrink %v4 5 []
%s5  = store %o5 %r5
%v5  = after %v4 %s5
