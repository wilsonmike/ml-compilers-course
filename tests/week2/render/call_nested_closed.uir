# render
# a nested call's body keeps its own param 0 when inlined
%a  = buffer 2 [1 2] dtype=i32 slot=0
%o  = buffer 1 dtype=i32 slot=1
%p0 = param [] slot=0 dtype=i32 addrspace=ALU
%p1 = param [] slot=1 dtype=i32 addrspace=ALU
%in = add %p0 100
%ou = call %in %p1
%e0 = shrink %a 0 []
%e1 = shrink %a 1 []
%x  = load %e0
%y  = load %e1
%r  = call %ou %x %y
%oe = shrink %o 0 []
%s  = store %oe %r
%o1 = after %o %s
