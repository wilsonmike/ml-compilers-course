# render
# a nested call's body keeps its own param 0 when inlined
%a  = buffer 2 dtype=i32 slot=0 data=[1 2]
%o  = buffer 1 dtype=i32 slot=1
%p0 = param 0 dtype=i32
%p1 = param 1 dtype=i32
%in = add %p0 100
%ou = call %in %p1
%e0 = shrink %a 0 shape=[]
%e1 = shrink %a 1 shape=[]
%x  = load %e0
%y  = load %e1
%r  = call %ou %x %y
%oe = shrink %o 0 shape=[]
%s  = store %oe %r
%o1 = after %o %s
