# render
# an old-version load whose value is used two stores later
%b  = buffer 2 dtype=i32 slot=0 data=[10 20]
%e0 = shrink %b 0 shape=[]
%e1 = shrink %b 1 shape=[]
%x  = load %e0
%s0 = store %e0 0
%b1 = after %b %s0
%f1 = shrink %b1 1 shape=[]
%s1 = store %f1 5
%b2 = after %b1 %s1
%g1 = shrink %b2 1 shape=[]
%y  = load %g1
%z  = add %x %y
%g0 = shrink %b2 0 shape=[]
%s2 = store %g0 %z
%b3 = after %b2 %s2
