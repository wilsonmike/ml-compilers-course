# render
# div and mod of loaded values floor, and a zero divisor gives -1 and x: the C needs more than / and %
%in = buffer 6 dtype=i32 slot=0 data=[-7 2 5 0 -2147483648 -1]
%o  = buffer 6 dtype=i32 slot=1
%v  = load %in
%a  = index %v 0
%b  = index %v 1
%c  = index %v 2
%z  = index %v 3
%m  = index %v 4
%n  = index %v 5
%q0 = div %a %b
%r0 = mod %a %b
%q1 = div %c %z
%r1 = mod %c %z
%q2 = div %m %n
%r2 = mod %m %n
%w  = stack %q0 %r0 %q1 %r1 %q2 %r2
%s  = store %o %w
%o1 = after %o %s
