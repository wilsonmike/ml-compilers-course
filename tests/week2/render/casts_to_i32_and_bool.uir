# render
# f32 to i32 truncates, and anything to bool is != 0, nan included
%f  = buffer 6 dtype=f32 slot=0 data=[-3.7 3.99 -0.5 nan -0.0 2147483520.0]
%oi = buffer 3 dtype=i32 slot=1
%ob = buffer 4 dtype=bool slot=2
%e0 = shrink %f 0 shape=[]
%e1 = shrink %f 1 shape=[]
%e2 = shrink %f 2 shape=[]
%e3 = shrink %f 3 shape=[]
%e4 = shrink %f 4 shape=[]
%e5 = shrink %f 5 shape=[]
%x0 = load %e0
%x1 = load %e1
%x2 = load %e2
%x3 = load %e3
%x4 = load %e4
%x5 = load %e5
%i0 = cast %x0 dtype=i32
%i1 = cast %x1 dtype=i32
%i2 = cast %x5 dtype=i32
%v  = stack %i0 %i1 %i2
%s0 = store %oi %v
%oi1 = after %oi %s0
%b0 = cast %x3 dtype=bool
%b1 = cast %x4 dtype=bool
%b2 = cast %i0 dtype=bool
%n2 = cast %x2 dtype=i32
%b3 = cast %n2 dtype=bool
%w  = stack %b0 %b1 %b2 %b3
%s1 = store %ob %w
%ob1 = after %ob %s1
