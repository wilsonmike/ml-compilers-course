# render
# three buffers of different dtypes in one kernel
%f  = buffer 2 [1.25 -2.5] dtype=f32 slot=0
%i  = buffer 2 [7 -7] dtype=i32 slot=1
%b  = buffer 2 dtype=bool slot=2
%f0 = shrink %f 0 []
%f1 = shrink %f 1 []
%i0 = shrink %i 0 []
%x  = load %f0
%y  = load %f1
%n  = load %i0
%c  = cmplt %y %x
%d  = cast %n dtype=f32
%z  = mul %x %d
%sf = store %f1 %z
%fa = after %f %sf
%k  = cast %x dtype=i32
%m  = add %n %k
%si = store %i0 %m
%ia = after %i %si
%w  = stack %c false
%sb = store %b %w
%ba = after %b %sb
