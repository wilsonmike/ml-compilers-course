# render
# swap: the second store uses a load of the original version, so loads must be scheduled first
%b  = buffer 3 dtype=i32 slot=0 data=[1 2 3]
%e0 = shrink %b 0 shape=[]
%e2 = shrink %b 2 shape=[]
%x  = load %e0
%y  = load %e2
%s0 = store %e0 %y
%b1 = after %b %s0
%f2 = shrink %b1 2 shape=[]
%s1 = store %f2 %x
%b2 = after %b1 %s1
