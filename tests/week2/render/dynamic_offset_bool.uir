# render
# a bool-derived offset picks one of two elements
%c  = buffer 1 dtype=bool slot=0 data=[true]
%a  = buffer 2 dtype=f32 slot=1 data=[0.5 0.25]
%o  = buffer 1 dtype=f32 slot=2
%ce = shrink %c 0 shape=[]
%cv = load %ce
%k  = cast %cv dtype=i32
%e  = shrink %a %k shape=[]
%x  = load %e
%oe = shrink %o 0 shape=[]
%s  = store %oe %x
%o1 = after %o %s
