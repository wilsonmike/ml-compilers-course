# render
# a bool-derived offset picks one of two elements
%c  = buffer 1 [true] dtype=bool slot=0
%a  = buffer 2 [0.5 0.25] dtype=f32 slot=1
%o  = buffer 1 dtype=f32 slot=2
%ce = shrink %c 0 []
%cv = load %ce
%k  = cast %cv dtype=i32
%e  = shrink %a %k []
%x  = load %e
%oe = shrink %o 0 []
%s  = store %oe %x
%o1 = after %o %s
