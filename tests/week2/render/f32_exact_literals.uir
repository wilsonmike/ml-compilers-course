# render
# f32 constants need every digit: 1/3 and the largest finite f32 must come out exact
%a  = buffer 1 dtype=f32 slot=0 data=[1.0]
%o  = buffer 4 dtype=f32 slot=1
%e  = shrink %a 0 shape=[]
%x  = load %e
%p  = mul %x 0.33333334
%q  = mul %x 3.4028234663852886e38
%u  = mul %x 1e-45
%w  = mul %x 16777215.0
%v  = stack %p %q %u %w
%s  = store %o %v
%o1 = after %o %s
