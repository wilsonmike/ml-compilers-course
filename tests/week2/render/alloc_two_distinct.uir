# render
# two same-size allocs are separate arrays
%o  = buffer 4 dtype=f32 slot=0
%a  = alloc 2 dtype=f32
%b  = alloc 2 dtype=f32
%ae = shrink %a 0 shape=[]
%sa = store %ae 1.5
%a1 = after %a %sa
%be = shrink %b 1 shape=[]
%sb = store %be 2.5
%b1 = after %b %sb
%va = load %a1
%vb = load %b1
%oa = shrink %o 0 shape=[2]
%s1 = store %oa %va
%o1 = after %o %s1
%ob = shrink %o1 2 shape=[2]
%s2 = store %ob %vb
%o2 = after %o1 %s2
