# render
# calls render inline: the body runs on loaded args
%a  = buffer 2 dtype=i32 slot=0 data=[5 -3]
%o  = buffer 2 dtype=i32 slot=1
%p  = param 0 dtype=i32
%q  = param 1 dtype=i32
%m  = mul %p 10
%f  = add %m %q
%e0 = shrink %a 0 shape=[]
%e1 = shrink %a 1 shape=[]
%x  = load %e0
%y  = load %e1
%r0 = call %f %x %y
%r1 = call %f %y %x
%w  = stack %r0 %r1
%s  = store %o %w
%o1 = after %o %s
