# render
# a constant positive divisor still needs floor semantics when x can be negative: -7 div 4 is -2, mod is 1
%in = buffer 1 [-7] dtype=i32 slot=0
%o  = buffer 2 dtype=i32 slot=1
%e  = shrink %in 0 []
%x  = load %e
%q  = div %x 4
%r  = mod %x 4
%w  = stack %q %r
%s  = store %o %w
%o1 = after %o %s
