# render
# cmplt with nan is false, and where picks a branch
%in  = buffer 5 dtype=f32 slot=0 data=[nan 1.0 2.0 -0.0 0.0]
%out = buffer 4 dtype=f32 slot=1
%e0 = shrink %in 0 shape=[]
%x0 = load %e0
%e1 = shrink %in 1 shape=[]
%x1 = load %e1
%e2 = shrink %in 2 shape=[]
%x2 = load %e2
%e3 = shrink %in 3 shape=[]
%x3 = load %e3
%e4 = shrink %in 4 shape=[]
%x4 = load %e4
%c0 = cmplt %x0 %x1
%c1 = cmplt %x1 %x0
%c2 = cmplt %x3 %x4
%c3 = cmplt %x1 %x2
%r0 = where %c0 %x1 %x2
%o0 = shrink %out 0 shape=[]
%s0 = store %o0 %r0
%v0 = after %out %s0
%r1 = where %c1 %x1 %x2
%o1 = shrink %v0 1 shape=[]
%s1 = store %o1 %r1
%v1 = after %v0 %s1
%r2 = where %c2 %x1 %x2
%o2 = shrink %v1 2 shape=[]
%s2 = store %o2 %r2
%v2 = after %v1 %s2
%r3 = where %c3 %x1 %x2
%o3 = shrink %v2 3 shape=[]
%s3 = store %o3 %r3
%v3 = after %v2 %s3
