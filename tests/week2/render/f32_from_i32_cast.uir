# render
# i32 to f32 rounds to nearest even, and bool to f32 is 0 or 1
%in  = buffer 1 dtype=f32 slot=0 data=[0.0]
%out = buffer 5 dtype=f32 slot=1
%e0 = shrink %in 0 shape=[]
%x0 = load %e0
%i0 = add 16777216 1
%i1 = add 2147483647 0
%i2 = add -16777217 0
%t = cmplt 1 2
%f = cmplt 2 1
%r0 = cast %i0 dtype=f32
%o0 = shrink %out 0 shape=[]
%s0 = store %o0 %r0
%v0 = after %out %s0
%r1 = cast %i1 dtype=f32
%o1 = shrink %v0 1 shape=[]
%s1 = store %o1 %r1
%v1 = after %v0 %s1
%r2 = cast %i2 dtype=f32
%o2 = shrink %v1 2 shape=[]
%s2 = store %o2 %r2
%v2 = after %v1 %s2
%r3 = cast %t dtype=f32
%o3 = shrink %v2 3 shape=[]
%s3 = store %o3 %r3
%v3 = after %v2 %s3
%r4 = cast %f dtype=f32
%o4 = shrink %v3 4 shape=[]
%s4 = store %o4 %r4
%v4 = after %v3 %s4
