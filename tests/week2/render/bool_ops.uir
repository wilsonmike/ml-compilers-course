# render
# bool xor, where on bools, and bool to i32
%b  = buffer 2 dtype=bool slot=0 data=[true false]
%o  = buffer 4 dtype=bool slot=1
%oi = buffer 2 dtype=i32 slot=2
%e0 = shrink %b 0 shape=[]
%e1 = shrink %b 1 shape=[]
%x  = load %e0
%y  = load %e1
%a  = xor %x %y
%c  = xor %x %x
%d  = where %y %x %y
%n  = where %x %y %x
%v  = stack %a %c %d %n
%s  = store %o %v
%o1 = after %o %s
%i  = cast %x dtype=i32
%j  = cast %y dtype=i32
%w  = stack %i %j
%s2 = store %oi %w
%oi1 = after %oi %s2
