# render
# INT_MIN / -1 and INT_MIN % -1 are UB in C; the kernel must not trap
%in  = buffer 3 [-2147483648 -1 1] dtype=i32 slot=0
%out = buffer 5 dtype=i32 slot=1
%e0  = shrink %in 0 []
%x0  = load %e0
%e1  = shrink %in 1 []
%x1  = load %e1
%e2  = shrink %in 2 []
%x2  = load %e2
%r0  = div %x0 %x1
%o0  = shrink %out 0 []
%s0  = store %o0 %r0
%v0  = after %out %s0
%r1  = mod %x0 %x1
%o1  = shrink %v0 1 []
%s1  = store %o1 %r1
%v1  = after %v0 %s1
%r2  = div %x0 %x2
%o2  = shrink %v1 2 []
%s2  = store %o2 %r2
%v2  = after %v1 %s2
%r3  = mod %x0 %x2
%o3  = shrink %v2 3 []
%s3  = store %o3 %r3
%v3  = after %v2 %s3
%r4  = div %x1 %x1
%o4  = shrink %v3 4 []
%s4  = store %o4 %r4
%v4  = after %v3 %s4
