# render
# a longer f32 chain where every intermediate rounds
%a  = buffer 3 dtype=f32 slot=0 data=[0.1 0.7 3.0]
%o  = buffer 1 dtype=f32 slot=1
%e0 = shrink %a 0 shape=[]
%e1 = shrink %a 1 shape=[]
%e2 = shrink %a 2 shape=[]
%x  = load %e0
%y  = load %e1
%z  = load %e2
%r  = recip %z
%p  = mul %x %y
%q  = add %p %r
%w  = mul %q %q
%u  = add %w -0.1
%oe = shrink %o 0 shape=[]
%s  = store %oe %u
%o1 = after %o %s
