# render
# shl into the sign bit and past it
%in  = buffer 4 dtype=i32 slot=0 data=[1 3 -1 31]
%out = buffer 4 dtype=i32 slot=1
%e0 = shrink %in 0 shape=[]
%x0 = load %e0
%e1 = shrink %in 1 shape=[]
%x1 = load %e1
%e2 = shrink %in 2 shape=[]
%x2 = load %e2
%e3 = shrink %in 3 shape=[]
%x3 = load %e3
%r0 = shl %x0 %x3
%o0 = shrink %out 0 shape=[]
%s0 = store %o0 %r0
%v0 = after %out %s0
%r1 = shl %x1 %x3
%o1 = shrink %v0 1 shape=[]
%s1 = store %o1 %r1
%v1 = after %v0 %s1
%r2 = shl %x2 %x0
%o2 = shrink %v1 2 shape=[]
%s2 = store %o2 %r2
%v2 = after %v1 %s2
%r3 = shl %x0 0
%o3 = shrink %v2 3 shape=[]
%s3 = store %o3 %r3
%v3 = after %v2 %s3
