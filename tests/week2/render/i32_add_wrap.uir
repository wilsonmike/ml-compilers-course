# render
# i32 add wraps, and in C that has to go through uint32_t
%in  = buffer 4 [2147483647 1 -2147483648 -1] dtype=i32 slot=0
%out = buffer 4 dtype=i32 slot=1
%e0  = shrink %in 0 []
%x0  = load %e0
%e1  = shrink %in 1 []
%x1  = load %e1
%e2  = shrink %in 2 []
%x2  = load %e2
%e3  = shrink %in 3 []
%x3  = load %e3
%r0  = add %x0 %x1
%o0  = shrink %out 0 []
%s0  = store %o0 %r0
%v0  = after %out %s0
%r1  = add %x2 %x3
%o1  = shrink %v0 1 []
%s1  = store %o1 %r1
%v1  = after %v0 %s1
%r2  = add %x0 %x0
%o2  = shrink %v1 2 []
%s2  = store %o2 %r2
%v2  = after %v1 %s2
%r3  = add %x2 %x2
%o3  = shrink %v2 3 []
%s3  = store %o3 %r3
%v3  = after %v2 %s3
