# swap two elements: both loads read the original version
%b  = buffer 2 [1 2] dtype=i32 slot=0
%e0 = shrink %b 0 []
%e1 = shrink %b 1 []
%x  = load %e0
%y  = load %e1
%s0 = store %e0 %y
%b1 = after %b %s0
%f1 = shrink %b1 1 []
%s1 = store %f1 %x
%b2 = after %b1 %s1
%v  = load %b2
%w  = stack 2 1
%t  = assert %v %w
