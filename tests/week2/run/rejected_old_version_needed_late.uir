# the offset of a load from the old version depends on the new version: no order works
%b  = buffer 4 [1 2 3 0] dtype=i32 slot=0
%e3 = shrink %b 3 []
%s  = store %e3 2
%b1 = after %b %s
%f3 = shrink %b1 3 []
%k  = load %f3
%m  = max %k 0
%o  = mod %m 4
%g  = shrink %b %o []
%x  = load %g
%t  = assert %x 3
