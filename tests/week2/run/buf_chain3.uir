# expect: pass
# three stores in a row, each into the previous version
%b  = buffer 3 dtype=i32 slot=0
%e0 = shrink %b 0 shape=[]
%s0 = store %e0 7
%b1 = after %b %s0
%e1 = shrink %b1 1 shape=[]
%s1 = store %e1 8
%b2 = after %b1 %s1
%e2 = shrink %b2 2 shape=[]
%s2 = store %e2 9
%b3 = after %b2 %s2
%v  = load %b3
%w  = stack 7 8 9
%t  = assert %v %w
