# expect: pass
# without data=, a buffer starts as zeros of its dtype
%i  = buffer 3 dtype=i32 slot=0
%f  = buffer 2 dtype=f32 slot=1
%b  = buffer 2 dtype=bool slot=2
%vi = load %i
%vf = load %f
%vb = load %b
%zi = stack 0 0 0
%zf = stack 0.0 0.0
%zb = stack false false
%t0 = assert %vi %zi
%t1 = assert %vf %zf
%t2 = assert %vb %zb
