# expect: pass
# a bool cast to i32 is in [0, 1], so it can index a 2-element buffer
%c  = buffer 1 dtype=bool slot=0 data=[true]
%b  = buffer 2 dtype=i32 slot=1 data=[3 4]
%ce = shrink %c 0 shape=[]
%cv = load %ce
%o  = cast %cv dtype=i32
%e  = shrink %b %o shape=[]
%x  = load %e
%t  = assert %x 4
