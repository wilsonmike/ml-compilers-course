# expect: pass
# a loaded index masked with max and mod is provably in [0, 3]
%i  = buffer 1 dtype=i32 slot=0 data=[6]
%b  = buffer 4 dtype=i32 slot=1 data=[10 20 30 40]
%ie = shrink %i 0 shape=[]
%k  = load %ie
%m  = max %k 0
%o  = mod %m 4
%e  = shrink %b %o shape=[]
%x  = load %e
%t  = assert %x 30
