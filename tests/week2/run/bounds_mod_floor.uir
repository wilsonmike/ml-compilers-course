# mod by a positive y is in [0, y - 1] even for a negative x, so a loaded value mod 4 is a safe offset
%i  = buffer 1 dtype=i32 slot=0 data=[-3]
%b  = buffer 4 dtype=i32 slot=1 data=[10 11 12 13]
%ie = shrink %i 0 shape=[]
%k  = load %ie
%o  = mod %k 4
%e  = shrink %b %o shape=[]
%x  = load %e
%t  = assert %x 11
