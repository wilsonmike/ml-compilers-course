# expect: invalid
# a local loop inside a warp loop: phases don't nest either way
%o = buffer 32 dtype=i32 slot=0
%g = range 1 axis=global
%w = range 1 axis=warp
%t = range 32 axis=local
%gg = mul %g 32
%ww = mul %w 32
%wt = add %ww %t
%off = add %gg %wt
%v = shrink %o %off shape=[]
%s = store %v 1
%et = end %s %t
%ew = end %et %w
%eg = end %ew %g
%o1 = after %o %eg
