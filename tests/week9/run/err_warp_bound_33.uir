# expect: invalid
# a block has at most 32 warps (1024 threads)
%A = buffer 8448 dtype=i8 slot=0
%B = buffer 256 dtype=i8 slot=1
%C = buffer 8448 dtype=i32 slot=2
%g = range 1 axis=global
%w = range 33 axis=warp
%gg = mul %g 8448
%ww = mul %w 256
%o = add %gg %ww
%c = shrink %C %o shape=[]
%a = shrink %A %o shape=[]
%m = mma %c %a %B lda=16 ldb=16 ldc=16
%ew = end %m %w
%eg = end %ew %g
%C1 = after %C %eg
