# expect: invalid
# an offset of 32 * k + j isn't a provable multiple of 32
%A = buffer 4096 dtype=i8 slot=0
%B = buffer 256 dtype=i8 slot=1
%C = buffer 256 dtype=i32 slot=2
%k = range 4
%j = range 2
%k32 = mul %k 32
%o = add %k32 %j
%a = shrink %A %o shape=[]
%m = mma %C %a %B lda=16 ldb=16 ldc=16
%ej = end %m %j
%ek = end %ej %k
%C1 = after %C %ek
