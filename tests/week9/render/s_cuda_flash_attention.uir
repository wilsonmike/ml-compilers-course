%s = mul %v394 0.1767766922712326
%v395 = shrink %v60 %t2 shape=[]
%v396 = shrink %l %t2 shape=[]
%v397 = load %v395
%v398 = load %v396
%mnew = max %v397 %s
%v399 = sub %v397 %mnew
%corr = exp %v399
%v400 = sub %s %mnew
%pj = exp %v400
%v401 = mul %v398 %corr
%v402 = add %v401 %pj
%v403 = store %v395 %mnew
%v404 = store %v396 %v402
%d2 = range 32 axis=upcast
%v405 = mul %t2 32
%v406 = add %v405 %d2
%v407 = shrink %acc %v406 shape=[]
%v408 = mul %j 32
%v409 = add %v408 %d2
%v410 = shrink %v77 %v409 shape=[]
