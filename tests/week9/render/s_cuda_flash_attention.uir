%v419 = end %v418 %t2
%ekt = end %e1 %v419 %kt
%v420 = after %acc %ekt
%v421 = after %l %ekt
# phase 3: O[row] = acc / l
%t3 = range 64 axis=local
%d3 = range 32 axis=upcast
%v422 = shrink %v421 %t3 shape=[]
%v423 = load %v422
%v424 = mul %t3 32
%v425 = add %v424 %d3
