# cuda speed: 0.8
# time: 180
# flash attention, 16 heads of 1024 queries, head size 32: at least 0.8 of the reference's speed. Each thread's
# query row, sums and running max must live in registers: in shared memory it runs at about 0.6
%Q = buffer 524288 dtype=f32 slot=0
%K = buffer 524288 dtype=f32 slot=1
%V = buffer 524288 dtype=f32 slot=2
%O = buffer 524288 dtype=f32 slot=3
# fill Q, K and V in kernels of their own, so the test needs no data files
%v1 = range 2048 axis=global
%v2 = range 256 axis=local
%v3 = mul %v1 256
%v4 = add %v3 %v2
%v5 = mul %v4 37
%v6 = add %v5 11
%v7 = mod %v6 101
%v8 = add %v7 -50
%v9 = cast %v8 dtype=f32
%v10 = mul %v9 0.02
%v11 = shrink %Q %v4 shape=[]
%v12 = store %v11 %v10
%v13 = end %v12 %v2
%v14 = end %v13 %v1
%v15 = after %Q %v14
%v16 = range 2048 axis=global
%v17 = range 256 axis=local
%v18 = mul %v16 256
%v19 = add %v18 %v17
%v20 = mul %v19 53
%v21 = add %v20 5
%v22 = mod %v21 97
%v23 = add %v22 -48
%v24 = cast %v23 dtype=f32
%v25 = mul %v24 0.02
%v26 = shrink %K %v19 shape=[]
%v27 = store %v26 %v25
%v28 = end %v27 %v17
%v29 = end %v28 %v16
%v30 = after %K %v29
%v31 = range 2048 axis=global
%v32 = range 256 axis=local
%v33 = mul %v31 256
%v34 = add %v33 %v32
%v35 = mul %v34 29
%v36 = add %v35 3
%v37 = mod %v36 89
%v38 = add %v37 -44
%v39 = cast %v38 dtype=f32
%v40 = mul %v39 0.02
%v41 = shrink %V %v34 shape=[]
%v42 = store %v41 %v40
%v43 = end %v42 %v32
%v44 = end %v43 %v31
%v45 = after %V %v44
%qr = alloc 2048 dtype=f32
%acc = alloc 2048 dtype=f32
%mx = alloc 64 dtype=f32
%l = alloc 64 dtype=f32
%Ks = alloc 2048 dtype=f32
%Vs = alloc 2048 dtype=f32
%g = range 256 axis=global
%h = div %g 16
# phase 0: thread t loads query row g*BQ + t, and starts its running max at -inf (its running sum starts at 0)
%t0 = range 64 axis=local
%d0 = range 32 axis=upcast
%v46 = mul %t0 32
%v47 = add %v46 %d0
%v48 = shrink %qr %v47 shape=[]
%v49 = mul %g 2048
%v50 = mul %t0 32
%v51 = add %v49 %v50
%v52 = add %v51 %d0
%v53 = shrink %v15 %v52 shape=[]
%v54 = load %v53
%v55 = store %v48 %v54
%v56 = end %v55 %d0
%v57 = shrink %mx %t0 shape=[]
%v58 = store %v57 -inf
%e0 = end %v56 %v58 %t0
%v59 = after %qr %e0
%v60 = after %mx %e0
%kt = range 16
# phase 1: copy key and value rows kt*BK .. kt*BK + BK-1 into shared memory
%t1 = range 64 axis=local
%p = range 32 axis=upcast
%v61 = mul %p 64
%v62 = add %v61 %t1
%v63 = mul %h 32768
%v64 = mul %kt 2048
%v65 = add %v63 %v64
%v66 = add %v65 %v62
%v67 = shrink %Ks %v62 shape=[]
%v68 = shrink %v30 %v66 shape=[]
%v69 = load %v68
%v70 = store %v67 %v69
%v71 = shrink %Vs %v62 shape=[]
%v72 = shrink %v45 %v66 shape=[]
%v73 = load %v72
%v74 = store %v71 %v73
%v75 = end %v70 %v74 %p
%e1 = end %v75 %t1
%v76 = after %Ks %e1
%v77 = after %Vs %e1
# phase 2: thread t folds keys j = 0 .. BK-1 into its row, one at a time
%t2 = range 64 axis=local
%j = range 64
%v78 = mul %t2 32
%v79 = shrink %v59 %v78 shape=[]
%v80 = load %v79
%v81 = mul %j 32
%v82 = shrink %v76 %v81 shape=[]
%v83 = load %v82
%v84 = mul %v80 %v83
%v85 = mul %t2 32
%v86 = add %v85 1
%v87 = shrink %v59 %v86 shape=[]
