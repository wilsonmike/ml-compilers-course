# cuda
# i8 in a kernel: y = low 8 bits of 3x (it wraps), z = x / 2 as f32
%x = buffer 256 dtype=i8 slot=0 data=[106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106 106]
%y = buffer 256 dtype=i8 slot=1
%z = buffer 256 dtype=f32 slot=2
%g = range 4 axis=global
%t = range 64 axis=local
%v1 = mul %g 64
%v2 = add %v1 %t
%v3 = shrink %x %v2 shape=[]
%v4 = load %v3
%v5 = cast %v4 dtype=i32
%v6 = shrink %y %v2 shape=[]
%v7 = mul %v5 3
%v8 = cast %v7 dtype=i8
%v9 = store %v6 %v8
%v10 = shrink %z %v2 shape=[]
%v11 = cast %v5 dtype=f32
%v12 = mul %v11 0.5
%v13 = store %v10 %v12
%v14 = end %v9 %v13 %t
%v15 = end %v14 %g
%y1 = after %y %v15
%z1 = after %z %v15
