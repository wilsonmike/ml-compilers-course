%v1 = mul %it 16
%v2 = add %v1 %t
%v3 = div %v2 54
%v4 = mod %v2 54
%v5 = mul %v3 108
%v6 = mul %y 18
%v7 = add %v5 %v6
%v8 = add %v7 %v4
%v9 = shrink %Xs %v2 shape=[]
%v10 = shrink %X %v8 shape=[]
%v11 = load %v10
%v12 = store %v9 %v11
%v13 = end %v12 %it
%it2 = range 36
%v14 = mul %it2 16
%v15 = add %v14 %t
%v16 = mul %kb 576
%v17 = add %v16 %v15
%v18 = shrink %Wt %v17 shape=[]
%v19 = load %v18
%v20 = shrink %Ws %v15 shape=[]
%v21 = store %v20 %v19
%v22 = end %v21 %it2
%e1 = end %v13 %v22 %t
%v23 = after %Xs %e1
%v24 = after %Ws %e1
# phase 2: thread x adds X[c][y+dy][x+dx] * W[k][c][dy][dx] into its 8 sums, k = 8 kb + o
%t2 = range 16 axis=local
%c = range 8
%dy = range 3 axis=upcast
%dx = range 3 axis=upcast
%o = range 8 axis=upcast
%v25 = mul %c 54
%v26 = mul %dy 18
%v27 = add %v25 %v26
%v28 = add %v27 %t2
%v29 = add %v28 %dx
%v30 = shrink %v23 %v29 shape=[]
%v31 = load %v30
%v32 = mul %o 72
%v33 = mul %c 9
%v34 = mul %dy 3
%v35 = add %v32 %v33
%v36 = add %v35 %v34
%v37 = add %v36 %dx
%v38 = shrink %v24 %v37 shape=[]
%v39 = load %v38
%v40 = mul %t2 8
%v41 = add %v40 %o
%v42 = shrink %acc %v41 shape=[]
%v43 = load %v42
%v44 = mul %v31 %v39
%v45 = add %v43 %v44
%v46 = store %v42 %v45
%v47 = end %v46 %o
%v48 = end %v47 %dx
%v49 = end %v48 %dy
%v50 = end %v49 %c
%v51 = end %v50 %t2
%v52 = after %acc %v51
# phase 3: write the 8 output pixels
%t3 = range 16 axis=local
%o3 = range 8 axis=upcast
%v53 = mul %t3 8
%v54 = add %v53 %o3
%v55 = shrink %v52 %v54 shape=[]
%v56 = load %v55
%v57 = mul %kb 512
%v58 = mul %o3 64
%v59 = mul %y 16
%v60 = add %v57 %v58
%v61 = add %v60 %v59
%v62 = add %v61 %t3
%v63 = shrink %Y %v62 shape=[]
%v64 = store %v63 %v56
%v65 = end %v64 %o3
%v66 = end %v65 %t3
%v67 = end %e1 %v51 %v66 %g
%Y1 = after %Y %v67
