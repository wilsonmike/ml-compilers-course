# render
# the store into A comes first in the text, but the mma reads the version before it: the C must run the mma
# before the store overwrites A[0]
%A = buffer 256 dtype=i8 slot=0 data=[-1 3 4 -4 -2 -7 -6 -4 -1 8 -2 4 -8 6 7 6 4 7 -2 4 -6 7 -1 -8 0 8 5 7 4 -5 0 -5 -6 4 4 -5 -7 2 -1 -6 7 8 -2 -4 -6 -7 7 -2 -4 6 6 1 3 5 -4 -3 -5 2 3 7 8 -2 1 -4 3 8 1 8 -6 8 -1 3 -1 -8 1 2 -1 0 -7 5 0 4 1 5 -3 4 -5 -3 -8 -2 -3 1 -5 -8 4 2 -3 5 -1 -4 5 6 5 5 -6 -6 1 -5 -7 -6 -5 8 8 3 -4 8 7 -4 -6 -2 -8 -4 2 4 -5 1 3 2 3 -8 7 -2 -7 -7 -3 -3 2 5 6 -5 -6 -2 -1 7 7 -4 4 -5 -5 6 -4 6 8 -6 7 4 3 6 -1 -7 -2 -7 6 -5 -5 -2 -8 -8 3 5 8 -6 8 -2 8 -1 2 8 4 8 -2 -8 1 1 -6 2 4 -1 1 -6 5 3 2 8 1 3 1 -5 -2 7 3 4 1 -2 1 4 4 8 3 3 5 -2 7 8 8 -6 0 -3 -6 7 0 5 -5 0 1 0 8 0 0 5 -1 3 -1 -1 8 6 -1 -1 8 -2 3 7 -5 -5 4 -6 -3 5 -7 -4 -8 -2 0 -6 -5 6]
%B = buffer 256 dtype=i8 slot=1 data=[6 3 0 -4 -3 -8 2 8 6 -6 2 -7 4 -3 6 5 -3 -3 -1 -7 -5 -4 8 -6 4 -5 1 -2 -1 5 -6 0 -2 4 0 2 -7 -2 -8 5 -7 4 7 -4 -8 -1 5 -5 -8 -5 -2 -2 2 -8 -6 -4 -8 8 -6 7 -2 5 -6 4 -2 -6 -4 -3 -7 -7 0 -4 0 -7 -5 4 -1 -3 8 -7 3 8 -6 3 -5 3 6 -2 4 -2 -8 4 2 -8 5 -5 -2 -1 6 0 2 -6 1 1 -5 8 -7 -8 4 5 7 3 -1 -6 5 -1 -5 4 8 3 3 -4 1 -3 0 -8 -7 -3 0 -3 -5 -4 -8 -7 -7 6 -2 4 1 -8 3 1 -4 7 0 -4 -6 1 -5 -6 5 6 -4 4 -3 0 7 3 -5 -7 0 8 -4 -3 -6 -3 -1 -8 -2 -3 7 6 4 -6 -3 7 0 -6 -8 5 1 8 8 -6 1 -6 -1 -4 -5 -5 7 6 -7 7 -7 -8 3 -1 6 -1 3 7 -1 -7 -6 -7 5 5 -6 -6 -2 -7 -3 -6 -6 -8 3 7 7 -8 -6 2 -6 2 -8 6 6 -4 4 7 -4 -5 3 -1 6 -4 -2 -1 -5 -5 -7 -5 -6 -6 3 -5 -8 6 8 -2 3 -6 -1 -8 0 8]
%C = buffer 256 dtype=i32 slot=2
%h = cast 100 dtype=i8
%v1 = shrink %A 0 shape=[]
%s = store %v1 %h
%A1 = after %A %s
%m = mma %C %A %B lda=16 ldb=16 ldc=16
%C1 = after %C %m
