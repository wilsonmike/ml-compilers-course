# cuda
# a warp loop of 1: a block of 32 threads, one mma
%A = buffer 256 dtype=i8 slot=0 data=[7 -3 -2 2 1 2 -8 7 3 3 -6 4 6 2 -3 2 -8 8 -6 -3 2 -8 5 -4 -4 4 1 1 2 6 2 3 -3 0 5 5 -1 -4 -3 -7 3 7 -8 4 -6 1 -8 5 -3 -5 6 3 -6 4 -2 -5 3 2 -7 7 0 5 4 -2 -4 -6 4 7 -5 1 7 5 -8 3 -2 3 -3 8 6 6 -6 -5 -2 -3 -5 -8 4 -1 -2 0 6 5 2 7 -6 0 -1 -3 -5 -3 4 6 -4 2 -4 0 -6 -4 -4 3 -5 -4 -3 7 -6 5 0 5 -1 5 6 4 8 -6 -7 -4 8 2 7 -2 8 -4 -7 -7 7 3 6 2 0 7 1 -4 0 -4 3 1 -3 -3 0 5 -5 -4 8 -4 7 0 6 -5 3 -5 4 8 7 0 -2 -2 3 6 -4 1 -6 6 6 -4 8 -7 -2 -6 8 -8 0 -4 6 1 -3 -8 3 2 -2 7 2 4 -8 8 1 -3 1 0 2 6 8 -2 2 -3 -7 -7 2 1 -2 -4 -5 3 4 2 -2 -2 7 -6 -3 -6 6 2 2 -3 -1 4 -6 1 -8 -6 -2 -3 -2 -6 -6 3 -8 -2 -1 7 6 -5 -4 -8 -8 -3 -1 -4 -4 7 8 -7 1 -8 -4 -5]
%B = buffer 256 dtype=i8 slot=1 data=[7 -3 -2 2 1 2 -8 7 3 3 -6 4 6 2 -3 2 -8 8 -6 -3 2 -8 5 -4 -4 4 1 1 2 6 2 3 -3 0 5 5 -1 -4 -3 -7 3 7 -8 4 -6 1 -8 5 -3 -5 6 3 -6 4 -2 -5 3 2 -7 7 0 5 4 -2 -4 -6 4 7 -5 1 7 5 -8 3 -2 3 -3 8 6 6 -6 -5 -2 -3 -5 -8 4 -1 -2 0 6 5 2 7 -6 0 -1 -3 -5 -3 4 6 -4 2 -4 0 -6 -4 -4 3 -5 -4 -3 7 -6 5 0 5 -1 5 6 4 8 -6 -7 -4 8 2 7 -2 8 -4 -7 -7 7 3 6 2 0 7 1 -4 0 -4 3 1 -3 -3 0 5 -5 -4 8 -4 7 0 6 -5 3 -5 4 8 7 0 -2 -2 3 6 -4 1 -6 6 6 -4 8 -7 -2 -6 8 -8 0 -4 6 1 -3 -8 3 2 -2 7 2 4 -8 8 1 -3 1 0 2 6 8 -2 2 -3 -7 -7 2 1 -2 -4 -5 3 4 2 -2 -2 7 -6 -3 -6 6 2 2 -3 -1 4 -6 1 -8 -6 -2 -3 -2 -6 -6 3 -8 -2 -1 7 6 -5 -4 -8 -8 -3 -1 -4 -4 7 8 -7 1 -8 -4 -5]
%C = buffer 256 dtype=i32 slot=2
%g = range 1 axis=global
%w = range 1 axis=warp
%v1 = mul %g 256
%v2 = mul %w 256
%v3 = add %v1 %v2
%v4 = shrink %C %v3 shape=[]
%v5 = mul %w 256
%v6 = shrink %A %v5 shape=[]
%m = mma %v4 %v6 %B lda=16 ldb=16 ldc=16
%v7 = end %m %w
%v8 = end %v7 %g
%C1 = after %C %v8
