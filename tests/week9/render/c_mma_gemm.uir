%C = buffer 8192 dtype=i32 slot=2
%As = alloc 2048 dtype=i8
%Bs = alloc 2048 dtype=i8
%Cs = alloc 4096 dtype=i32
%g = range 2 axis=global
%bm = div %g 2
%bn = mod %g 2
%kt = range 2
# phase 1: 256 threads copy the 64x32 A tile and the 32x64 B tile into shared memory, tile-major
%t = range 256 axis=local
%q = range 8 axis=upcast
%v1 = div %t 16
%v2 = mod %t 16
%v3 = mul %bm 4096
%v4 = div %q 2
%v5 = mul %v4 1024
%v6 = mul %v1 64
%v7 = mul %kt 32
%v8 = mod %q 2
%v9 = mul %v8 16
%v10 = add %v3 %v5
%v11 = add %v10 %v6
%v12 = add %v11 %v7
%v13 = add %v12 %v9
%v14 = add %v13 %v2
%v15 = shrink %A %v14 shape=[]
%v16 = load %v15
%v17 = mul %q 256
%v18 = add %v17 %t
%v19 = shrink %As %v18 shape=[]
%v20 = store %v19 %v16
%v21 = mul %kt 4096
%v22 = div %q 4
%v23 = mul %v22 2048
%v24 = mul %v1 128
%v25 = mul %bn 64
%v26 = mod %q 4
%v27 = mul %v26 16
%v28 = add %v21 %v23
%v29 = add %v28 %v24
%v30 = add %v29 %v25
%v31 = add %v30 %v27
%v32 = add %v31 %v2
%v33 = shrink %B %v32 shape=[]
%v34 = load %v33
%v35 = shrink %Bs %v18 shape=[]
%v36 = store %v35 %v34
%v37 = end %v20 %v36 %q
%e1 = end %v37 %t
%v38 = after %As %e1
%v39 = after %Bs %e1
# phase 2: warp w adds A tile (mi, ki) times B tile (ki, ni) into C tile (mi, ni), for its two tiles of C
%w = range 8 axis=warp
%u = range 2 axis=upcast
%ki = range 2 axis=upcast
%v40 = div %w 2
%v41 = mod %w 2
%v42 = mul %v40 1024
%v43 = mul %v41 32
%v44 = mul %u 16
%v45 = add %v42 %v43
%v46 = add %v45 %v44
%v47 = mul %v40 512
%v48 = mul %ki 256
%v49 = add %v47 %v48
%v50 = mul %ki 1024
%v51 = mul %v41 512
%v52 = mul %u 256
%v53 = add %v50 %v51
%v54 = add %v53 %v52
%v55 = shrink %Cs %v46 shape=[]
