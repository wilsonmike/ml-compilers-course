# render
# padding 2 on i32
%X = buffer 4 dtype=i32 slot=0 data=[3 -1 4 1]
%W = buffer 3 dtype=i32 slot=1 data=[2 0 -1]
%Y = buffer 6 dtype=i32 slot=2
%o = range 6
%v4 = shrink %Y %o shape=[]
%v5 = store %v4 0
%v6 = after %Y %v5
%k = range 3
%v8 = add %o %k
%v9 = add %v8 -2
%v10 = max %v9 0
%v11 = mod %v10 4
%v12 = cmplt %v9 0
%v13 = cmplt %v9 4
%v14 = where %v12 false %v13
%v15 = shrink %X %v11 shape=[]
%v16 = load %v15
%v17 = shrink %W %k shape=[]
%v18 = load %v17
%v19 = mul %v16 %v18
%v20 = where %v14 %v19 0
%v21 = shrink %v6 %o shape=[]
%v22 = load %v21
%v23 = add %v22 %v20
%v24 = store %v21 %v23
%v25 = end %v24 %k
%v26 = end %v25 %o
%Y1 = after %Y %v26
