# render
# an f32 running total
%X = buffer 4 dtype=f32 slot=0 data=[0.1 0.2 0.3 100000000.0]
%Y = buffer 4 dtype=f32 slot=1
%acc = alloc 1 dtype=f32
%v3 = shrink %acc 0 shape=[]
%i = range 4
%v5 = shrink %X %i shape=[]
%v6 = load %v5
%v7 = load %v3
%v8 = add %v7 %v6
%v9 = store %v3 %v8
%v10 = shrink %Y %i shape=[]
%v11 = store %v10 %v8
%v12 = end %v9 %v11 %i
%Y1 = after %Y %v12
%v14 = after %acc %v12
