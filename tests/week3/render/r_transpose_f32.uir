# render
# f32 transpose keeps -0.0 and nan
%X = buffer 4 dtype=f32 slot=0 data=[-0.0 nan inf 1.5]
%Y = buffer 4 dtype=f32 slot=1
%i = range 2
%j = range 2
%v4 = mul %j 2
%v5 = add %v4 %i
%v6 = shrink %Y %v5 shape=[]
%v7 = mul %i 2
%v8 = add %v7 %j
%v9 = shrink %X %v8 shape=[]
%v10 = load %v9
%v11 = store %v6 %v10
%v12 = end %v11 %j
%v13 = end %v12 %i
%Y1 = after %Y %v13
