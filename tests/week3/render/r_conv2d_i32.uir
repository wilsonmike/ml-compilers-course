# render
# an i32 conv2d
%X = buffer 9 dtype=i32 slot=0 data=[1 2 3 4 5 6 7 8 9]
%W = buffer 4 dtype=i32 slot=1 data=[1 0 0 -1]
%Y = buffer 4 dtype=i32 slot=2
%oy = range 2
%ox = range 2
%v5 = mul %oy 2
%v6 = add %v5 %ox
%v7 = shrink %Y %v6 shape=[]
%v8 = store %v7 0
%v9 = after %Y %v8
%ky = range 2
%kx = range 2
%v12 = add %oy %ky
%v13 = add %ox %kx
%v14 = mul %v12 3
%v15 = add %v14 %v13
%v16 = shrink %X %v15 shape=[]
%v17 = load %v16
%v18 = mul %ky 2
%v19 = add %v18 %kx
%v20 = shrink %W %v19 shape=[]
%v21 = load %v20
%v22 = mul %v17 %v21
%v23 = shrink %v9 %v6 shape=[]
%v24 = load %v23
%v25 = add %v24 %v22
%v26 = store %v23 %v25
%v27 = end %v26 %kx
%v28 = end %v27 %ky
%v29 = end %v28 %ox
%v30 = end %v29 %oy
%Y1 = after %Y %v30
