# render
# three nested loops writing a 2x3x2 index cube
%b  = buffer 12 dtype=i32 slot=0
%i  = range 2
%j  = range 3
%k  = range 2
%i6 = mul %i 6
%j2 = mul %j 2
%a  = add %i6 %j2
%o  = add %a %k
%v  = shrink %b %o shape=[]
%x  = mul %o %o
%s  = store %v %x
%ek = end %s %k
%ej = end %ek %j
%ei = end %ej %i
%b1 = after %b %ei
