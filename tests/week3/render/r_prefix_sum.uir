# render
# a running total
%X = buffer 6 dtype=i32 slot=0 data=[1 -2 3 -4 5 2147483647]
%Y = buffer 6 dtype=i32 slot=1
%acc = alloc 1 dtype=i32
%v3 = shrink %acc 0 shape=[]
%i = range 6
%v5 = shrink %X %i shape=[]
%v6 = load %v5
%v7 = load %v3
%v8 = add %v7 %v6
%v9 = store %v3 %v8
%v10 = shrink %Y %i shape=[]
%v11 = store %v10 %v8
%v12 = end %v9 %v11 %i
%Y1 = after %Y %v12
%v14 = after %acc %v12
