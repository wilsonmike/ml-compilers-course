# render
# a trip count loaded from memory: the index is masked with mod so the view is provable
%n  = buffer 1 dtype=i32 slot=0 data=[6]
%b  = buffer 4 dtype=i32 slot=1
%nv = load %n
%nn = index %nv 0
%i  = range %nn
%m  = mod %i 4
%v  = shrink %b %m shape=[]
%cur = load %v
%y  = add %cur %i
%s  = store %v %y
%e  = end %s %i
%b1 = after %b %e
