# render
# one loop writes f32, i32 and bool buffers
%f  = buffer 3 dtype=f32 slot=0
%n  = buffer 3 dtype=i32 slot=1
%g  = buffer 3 dtype=bool slot=2
%i  = range 3
%fi = cast %i dtype=f32
%h  = mul %fi 0.5
%vf = shrink %f %i shape=[]
%vn = shrink %n %i shape=[]
%vg = shrink %g %i shape=[]
%sf = store %vf %h
%sq = mul %i -7
%sn = store %vn %sq
%od = mod %i 2
%bo = cast %od dtype=bool
%sg = store %vg %bo
%e  = end %sf %sn %sg %i
%f1 = after %f %e
%n1 = after %n %e
%g1 = after %g %e
