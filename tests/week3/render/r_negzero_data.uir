# render
# data=[-0.0 0.0] round-trips through a loop: recip of each lands in the output as -inf, inf
%b  = buffer 2 dtype=f32 slot=0 data=[-0.0 0.0]
%c  = buffer 2 dtype=f32 slot=1
%i  = range 2
%v  = shrink %b %i shape=[]
%x  = load %v
%r  = recip %x
%w  = shrink %c %i shape=[]
%s  = store %w %r
%e  = end %s %i
%c1 = after %c %e
