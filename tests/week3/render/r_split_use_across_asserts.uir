# render
# render must place the load where the whole program says, even though render ignores the assert that pins it
%b  = buffer 1 [10] dtype=i32 slot=0
%v0 = shrink %b 0 []
%x  = load %v0
%i  = range 3
%z  = mul %i 0
%v  = shrink %b %z []
%xz = add %x %z
%y  = add %xz 1
%s  = store %v %y
%e  = end %s %i
%b1 = after %b %e
%t1 = assert %x 10
