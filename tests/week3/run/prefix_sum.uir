# expect: pass
# a running total: two stores per iteration into two different memories, one end
%X = buffer 5 dtype=i32 slot=0 data=[1 2 3 4 5]
%Y = buffer 5 dtype=i32 slot=1
%acc = alloc 1 dtype=i32
%v3 = shrink %acc 0 shape=[]
%i = range 5
%v5 = shrink %X %i shape=[]
%v6 = load %v5
%v7 = load %v3
%v8 = add %v7 %v6
%v9 = store %v3 %v8
%v10 = shrink %Y %i shape=[]
%v11 = store %v10 %v8
%v12 = end %v9 %v11 %i
%Y1 = after %Y %v12
%v14 = after %acc %v12
%v15 = load %Y1
%v16 = stack 1 3 6 10 15
%v17 = assert %v15 %v16
