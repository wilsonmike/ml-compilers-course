# expect: pass
# a load of the pre-loop version, used after the loop, still sees the old contents
%b  = buffer 2 dtype=i32 slot=0 data=[3 4]
%o  = load %b
%i  = range 2
%v  = shrink %b %i shape=[]
%s  = store %v 0
%e  = end %s %i
%b1 = after %b %e
%n  = load %b1
%wo = stack 3 4
%wn = stack 0 0
%t0 = assert %o %wo
%t1 = assert %n %wn
