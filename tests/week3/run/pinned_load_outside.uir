# expect: pass
# the load's first use (x + 1) doesn't depend on the range, so both run once before the loop: every iteration writes 11
%b  = buffer 1 dtype=i32 slot=0 data=[10]
%i  = range 3
%z  = mul %i 0
%v  = shrink %b %z shape=[]
%v0 = shrink %b 0 shape=[]
%x  = load %v0
%y  = add %x 1
%s  = store %v %y
%e  = end %s %i
%b1 = after %b %e
%r  = load %b1
%q  = stack 11
%t  = assert %r %q
