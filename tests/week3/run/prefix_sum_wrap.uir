# a running total that wraps
%X   = buffer 3 [2147483647 1 1] dtype=i32 slot=0
%Y   = buffer 3 dtype=i32 slot=1
%acc = alloc 1 dtype=i32
%v3  = shrink %acc 0 []
%i   = range 3
%v5  = shrink %X %i []
%v6  = load %v5
%v7  = load %v3
%v8  = add %v7 %v6
%v9  = store %v3 %v8
%v10 = shrink %Y %i []
%v11 = store %v10 %v8
%v12 = end %v9 %v11 %i
%Y1  = after %Y %v12
%v15 = load %Y1
%v16 = stack 2147483647 -2147483648 -2147483647
%v17 = assert %v15 %v16
