# expect: pass
# two stores into one element in one iteration: the second reads the first through an after inside the loop
%b  = buffer 3 dtype=i32 slot=0
%i  = range 3
%v  = shrink %b %i shape=[]
%s1 = store %v 1
%b0 = after %b %s1
%v1 = shrink %b0 %i shape=[]
%x  = load %v1
%y  = add %x %i
%s2 = store %v1 %y
%e  = end %s2 %i
%b1 = after %b %e
%r  = load %b1
%q  = stack 1 2 3
%t  = assert %r %q
