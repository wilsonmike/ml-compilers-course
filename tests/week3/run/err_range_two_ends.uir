# expect: invalid
# a range is closed by exactly one end
%b  = buffer 3 dtype=i32 slot=0
%c  = buffer 3 dtype=i32 slot=1
%i  = range 3
%v  = shrink %b %i shape=[]
%s  = store %v 1
%e  = end %s %i
%w  = shrink %c %i shape=[]
%s2 = store %w 2
%e2 = end %s2 %i
%b1 = after %b %e
%c1 = after %c %e2
%t  = assert 1 1
