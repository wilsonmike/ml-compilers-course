# expect: invalid
# end over j repeats a store that doesn't use j. Otherwise j is well formed, so only the 'end must use its range' rule rejects it
%b  = buffer 3 dtype=i32 slot=0
%i  = range 3
%j  = range 2
%v  = shrink %b %i shape=[]
%s  = store %v 1
%ej = end %s %j
%ei = end %ej %i
%b1 = after %b %ei
%t  = assert 1 1
