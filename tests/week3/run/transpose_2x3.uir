# expect: pass
# transpose: read row-major, write column-major
%X = buffer 6 dtype=i32 slot=0 data=[1 2 3 4 5 6]
%Y = buffer 6 dtype=i32 slot=1
%i = range 2
%j = range 3
%v4 = mul %j 2
%v5 = add %v4 %i
%v6 = shrink %Y %v5 shape=[]
%v7 = mul %i 3
%v8 = add %v7 %j
%v9 = shrink %X %v8 shape=[]
%v10 = load %v9
%v11 = store %v6 %v10
%v12 = end %v11 %j
%v13 = end %v12 %i
%Y1 = after %Y %v13
%v15 = load %Y1
%v16 = stack 1 4 2 5 3 6
%v17 = assert %v15 %v16
