# expect: pass
# one end can repeat several stores into different buffers
%a  = buffer 3 dtype=i32 slot=0
%b  = buffer 3 dtype=i32 slot=1
%i  = range 3
%va = shrink %a %i shape=[]
%vb = shrink %b %i shape=[]
%sq = mul %i %i
%sa = store %va %i
%sb = store %vb %sq
%e  = end %sa %sb %i
%a1 = after %a %e
%b1 = after %b %e
%xa = load %a1
%xb = load %b1
%wa = stack 0 1 2
%wb = stack 0 1 4
%t0 = assert %xa %wa
%t1 = assert %xb %wb
