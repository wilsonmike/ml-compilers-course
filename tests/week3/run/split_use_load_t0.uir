# a load with uses inside and outside the loop runs once, before it: every iteration writes 10 + 1
%b  = buffer 1 dtype=i32 slot=0 data=[10]
%v0 = shrink %b 0 shape=[]
%x  = load %v0
%i  = range 3
%z  = mul %i 0
%v  = shrink %b %z shape=[]
%y  = add %x 1
%s  = store %v %y
%e  = end %s %i
%b1 = after %b %e
%r  = load %b1
%q  = stack 11
%t0 = assert %r %q
