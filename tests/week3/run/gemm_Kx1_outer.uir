# expect: pass
# Kx1 @ 1xN with K=1 inner loop is an outer product
%A = buffer 3 dtype=f32 slot=0 data=[1.0 2.0 3.0]
%B = buffer 4 dtype=f32 slot=1 data=[1.0 -1.0 0.5 10.0]
%C = buffer 12 dtype=f32 slot=2
%i = range 3
%j = range 4
%v5 = mul %i 4
%v6 = add %v5 %j
%v7 = shrink %C %v6 shape=[]
%v8 = store %v7 0.0
%v9 = after %C %v8
%k = range 1
%v11 = mul %i 1
%v12 = add %v11 %k
%v13 = shrink %A %v12 shape=[]
%v14 = load %v13
%v15 = mul %k 4
%v16 = add %v15 %j
%v17 = shrink %B %v16 shape=[]
%v18 = load %v17
%v19 = shrink %v9 %v6 shape=[]
%v20 = load %v19
%v21 = mul %v14 %v18
%v22 = add %v20 %v21
%v23 = store %v19 %v22
%v24 = end %v23 %k
%v25 = end %v24 %j
%v26 = end %v25 %i
%C1 = after %C %v26
%v28 = load %C1
%v29 = stack 1.0 -1.0 0.5 10.0 2.0 -2.0 1.0 20.0 3.0 -3.0 1.5 30.0
%v30 = assert %v28 %v29
