# a load with uses inside and outside the loop runs once, before it: every iteration writes 10 + 1
%b  = buffer 1 [10] dtype=i32 slot=0
%c  = buffer 1 dtype=i32 slot=1
%v0 = shrink %b 0 []
%x  = load %v0
%w  = shrink %c 0 []
%s2 = store %w %x
%c1 = after %c %s2
%rc = load %c1
%qc = stack 10
%t1 = assert %rc %qc
