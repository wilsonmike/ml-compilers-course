# expect: invalid
# after names %o, but the loop stores into %o0, the version after the reset: the versions would fork
%x  = buffer 3 dtype=i32 slot=0 data=[4 9 2]
%o  = buffer 1 dtype=i32 slot=1
%z  = shrink %o 0 shape=[]
%s0 = store %z 0
%o0 = after %o %s0
%k  = range 3
%xk = shrink %x %k shape=[]
%v  = load %xk
%c  = shrink %o0 0 shape=[]
%cur = load %c
%m  = add %cur %v
%s  = store %c %m
%e  = end %s %k
%o1 = after %o %e
%t  = assert 1 1
