# inside loop j, the inner loop stores into %o1, but its after names %o, the version before it
%x   = buffer 3 [4 9 2] dtype=i32 slot=0
%o   = buffer 2 dtype=i32 slot=1
%j   = range 2
%z   = shrink %o %j []
%s1  = store %z 0
%o1  = after %o %s1
%k   = range 3
%xk  = shrink %x %k []
%v   = load %xk
%c   = shrink %o1 %j []
%cur = load %c
%m   = add %cur %v
%s   = store %c %m
%e   = end %s %k
%o2  = after %o %e
%ej  = end %e %j
%o3  = after %o %ej
%t   = assert 1 1
