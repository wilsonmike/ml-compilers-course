# one end can repeat several stores into different buffers
%a  = buffer 3 dtype=i32 slot=0
%b  = buffer 3 dtype=i32 slot=1
%i  = range 3
%va = shrink %a %i []
%vb = shrink %b %i []
%sq = mul %i %i
%sa = store %va %i
%sb = store %vb %sq
%e  = end %sa %sb %i
%a1 = after %a %e
%xa = load %a1
%wa = stack 0 1 2
%t0 = assert %xa %wa
