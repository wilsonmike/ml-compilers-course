# an inner loop inside two loops can ignore the middle range, and it just reruns
%A  = buffer 4 dtype=i32 slot=0
%B  = buffer 6 dtype=i32 slot=1
%j  = range 2
%i  = range 2
%k  = range 3
%i3 = mul %i 3
%ik = add %i3 %k
%vb = shrink %B %ik []
%sb = store %vb %ik
%ek = end %sb %k
%j2 = mul %j 2
%ji = add %j2 %i
%va = shrink %A %ji []
%sa = store %va %ji
%ei = end %sa %ek %i
%ej = end %ei %j
%B1 = after %B %ej
%xb = load %B1
%wb = stack 0 1 2 3 4 5
%t1 = assert %xb %wb
