# expect: pass
# o[3b + t] with t up to 2 is fine: 3 is more than 2
%o = buffer 6 dtype=i32 slot=0
%b = range 2 axis=global
%t = range 3 axis=local
%m = mul %b 3
%i = add %m %t
%v = shrink %o %i shape=[]
%s = store %v %b
%et = end %s %t
%eb = end %et %b
%o1 = after %o %eb
%l = load %o1
%w = stack 0 0 0 1 1 1
%t9 = assert %l %w
