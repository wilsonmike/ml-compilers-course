# expect: invalid
# 4 threads write o[2b + (t div 2)]: threads 0 and 1 share a slot, so do 2 and 3
%o = buffer 4 dtype=i32 slot=0
%b = range 2 axis=global
%t = range 4 axis=local
%b2 = mul %b 2
%td = div %t 2
%off = add %b2 %td
%v = shrink %o %off shape=[]
%s = store %v %t
%et = end %s %t
%eb = end %et %b
%o1 = after %o %eb
