# expect: invalid
# all local loops in one kernel are the same block: one size
%o = buffer 8 dtype=i32 slot=0
%q = buffer 16 dtype=i32 slot=1
%b = range 2 axis=global
%t = range 4 axis=local
%m = mul %b 4
%i = add %m %t
%v = shrink %o %i shape=[]
%s = store %v 1
%et = end %s %t
%u = range 8 axis=local
%m2 = mul %b 8
%j = add %m2 %u
%v2 = shrink %q %j shape=[]
%s2 = store %v2 2
%eu = end %s2 %u
%eb = end %et %eu %b
%o1 = after %o %eb
%q1 = after %q %eb
