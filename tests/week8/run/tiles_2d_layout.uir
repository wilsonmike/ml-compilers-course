# expect: pass
# a 4x4 matrix as 2x2 blocks of 2x2 threads: by*8 + bx*2 + ty*4 + tx, a unique mixed-radix number
%o = buffer 16 dtype=i32 slot=0
%g = range 4 axis=global
%by = div %g 2
%bx = mod %g 2
%t = range 4 axis=local
%ty = div %t 2
%tx = mod %t 2
%a = mul %by 8
%c = mul %bx 2
%d = mul %ty 4
%e = add %a %c
%f = add %d %tx
%off = add %e %f
%v = shrink %o %off shape=[]
%s = store %v %g
%et = end %s %t
%eg = end %et %g
%o1 = after %o %eg
%l = load %o1
%w = stack 0 0 1 1 0 0 1 1 2 2 3 3 2 2 3 3
%t9 = assert %l %w
