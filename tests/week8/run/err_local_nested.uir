# expect: invalid
# a local loop inside another local loop
%o = buffer 32 dtype=i32 slot=0
%b = range 2 axis=global
%t = range 4 axis=local
%u = range 4 axis=local
%mb = mul %b 16
%m = mul %t 4
%i0 = add %m %u
%i = add %mb %i0
%v = shrink %o %i shape=[]
%s = store %v 1
%eu = end %s %u
%et = end %eu %t
%eb = end %et %b
%o1 = after %o %eb
