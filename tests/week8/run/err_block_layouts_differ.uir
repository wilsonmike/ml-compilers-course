# expect: invalid
# one buffer written with two different block layouts
%o = buffer 8 dtype=i32 slot=0
%b = range 3 axis=global
%t = range 2 axis=local
%m = mul %b 2
%i = add %m %t
%v = shrink %o %i shape=[]
%s = store %v 1
%et = end %s %t
%o1 = after %o %et
%u = range 2 axis=local
%m2 = mul %b 3
%j = add %m2 %u
%v2 = shrink %o1 %j shape=[]
%s2 = store %v2 2
%eu = end %s2 %u
%eb = end %et %eu %b
%o2 = after %o %eb
