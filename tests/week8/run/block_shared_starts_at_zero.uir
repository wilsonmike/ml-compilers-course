# expect: pass
# shared memory used only in one global loop starts at zero in every block: o = b + t
%o = buffer 6 dtype=i32 slot=0
%sh = alloc 3 dtype=i32
%b = range 2 axis=global
%t = range 3 axis=local
%sv = shrink %sh %t shape=[]
%cur = load %sv
%bt = add %b %t
%n = add %cur %bt
%s = store %sv %n
%e1 = end %s %t
%sh1 = after %sh %e1
%u = range 3 axis=local
%rv = shrink %sh1 %u shape=[]
%r = load %rv
%m = mul %b 3
%j = add %m %u
%ov = shrink %o %j shape=[]
%s2 = store %ov %r
%e2 = end %s2 %u
%eb = end %e1 %e2 %b
%o1 = after %o %eb
%l = load %o1
%w = stack 0 1 2 1 2 3
%t9 = assert %l %w
