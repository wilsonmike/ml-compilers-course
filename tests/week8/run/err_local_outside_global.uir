# expect: invalid
# a local loop runs inside a block, so it needs a global loop around it
%x = buffer 8 dtype=i32 slot=0 data=[1 2 3 4 5 6 7 8]
%o = buffer 8 dtype=i32 slot=1
%b = range 2
%t = range 4 axis=local
%m = mul %b 4
%i = add %m %t
%xv = shrink %x %i shape=[]
%xe = load %xv
%y = mul %xe 10
%ov = shrink %o %i shape=[]
%s = store %ov %y
%et = end %s %t
%eb = end %et %b
%o1 = after %o %eb
%l = load %o1
