# expect: invalid
# o[2b + t] with t up to 2: block 1 thread 0 and block 0 thread 2 both write o[2]. The coefficient 2 must be more than 2, not equal.
%o = buffer 5 dtype=i32 slot=0
%b = range 2 axis=global
%t = range 3 axis=local
%m = mul %b 2
%i = add %m %t
%v = shrink %o %i shape=[]
%s = store %v %b
%et = end %s %t
%eb = end %et %b
%o1 = after %o %eb
