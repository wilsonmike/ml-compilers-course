# expect: invalid
# by*4 + bx*2 + ty*2 + tx: bx and ty share a coefficient, so blocks overlap
%o = buffer 16 dtype=i32 slot=0
%g = range 4 axis=global
%by = div %g 2
%bx = mod %g 2
%t = range 4 axis=local
%ty = div %t 2
%tx = mod %t 2
%a = mul %by 4
%c = mul %bx 2
%d = mul %ty 2
%e = add %a %c
%f = add %d %tx
%off = add %e %f
%v = shrink %o %off shape=[]
%s = store %v %g
%et = end %s %t
%eg = end %et %g
%o1 = after %o %eg
