# cuda
# two phases through shared memory: without __syncthreads between them, threads read before others write
%x = buffer 128 dtype=f32 slot=0 data=[0.17219553887844086 0.5640580654144287 -0.4564054310321808 0.7687386870384216 0.7767257690429688 0.9102326035499573 0.2617352306842804 -0.3411979675292969 0.6400529742240906 -0.7762560248374939 0.09693917632102966 -0.726790726184845 0.5750847458839417 0.13223589956760406 0.5634294748306274 -0.7231733798980713 0.4600001275539398 0.589275598526001 -0.7318021059036255 -0.7921600341796875 -0.8454731702804565 -0.478421151638031 0.45938920974731445 -0.8136793971061707 0.8685076832771301 -0.15522260963916779 -0.5189511179924011 -0.6499807834625244 -0.8038874268531799 -0.03142989054322243 -0.894592821598053 0.23718011379241943 -0.34624600410461426 -0.707038164138794 -0.03595390170812607 0.23974354565143585 0.6946211457252502 -0.7971592545509338 0.006623100023716688 -0.7086013555526733 0.8254913091659546 -0.6824260950088501 -0.10927873849868774 0.2671949863433838 0.49035781621932983 -0.3164997696876526 0.7861318588256836 -0.2669083774089813 0.8267630338668823 -0.3461661636829376 -0.29468652606010437 0.33190542459487915 0.04181152954697609 -0.23209179937839508 0.3492639660835266 0.5039675235748291 -0.9836946725845337 -0.6891019940376282 -0.46540266275405884 0.8344401717185974 0.08234993368387222 -0.8293198347091675 0.24842850863933563 -0.683026134967804 -0.6095549464225769 0.8676923513412476 -0.27352842688560486 -0.6468378901481628 -0.7060068249702454 0.019602345302700996 0.1300499588251114 -0.2496734857559204 -0.47988712787628174 -0.23184426128864288 0.7170543074607849 -0.37933632731437683 -0.5352364778518677 -0.5866743922233582 -0.9567739367485046 -0.2528195381164551 0.16638199985027313 0.37640494108200073 -0.6156988143920898 -0.10703714191913605 0.8438724875450134 -0.05388842895627022 -0.5782684683799744 -0.7658714652061462 0.6478385329246521 0.31436339020729065 -0.766730546951294 0.3162095248699188 -0.7755746245384216 -0.11877705156803131 0.13071754574775696 -0.1093086376786232 0.12324383109807968 -0.8521077632904053 -0.7662820219993591 -0.5073691606521606 0.40743914246559143 -0.1629236340522766 0.3847697377204895 0.2526847720146179 0.4330592155456543 0.8104550838470459 0.10088898986577988 -0.2840863764286041 -0.4949377775192261 0.30622032284736633 -0.6407225131988525 0.8940479755401611 0.8622703552246094 0.3252899944782257 0.921101450920105 0.07074946165084839 0.974250853061676 0.3103732764720917 0.11754253506660461 -0.36077791452407837 0.9202271699905396 -0.18631471693515778 -0.573306143283844 -0.3108079135417938 -0.9655792713165283 0.07166732847690582 -0.7808226346969604 -0.7207249999046326]
%o = buffer 128 dtype=f32 slot=1
%sh = alloc 64 dtype=f32
%b = range 2 axis=global
%m = mul %b 64
# phase 1: thread t copies element t of the block's chunk into shared memory
%t = range 64 axis=local
%i = add %m %t
%xv = shrink %x %i shape=[]
%xe = load %xv
%sv = shrink %sh %t shape=[]
%s1 = store %sv %xe
%e1 = end %s1 %t
%sh1 = after %sh %e1
# phase 2: thread u writes the element thread 63 - u loaded
%u = range 64 axis=local
%nu = mul %u -1
%ru = add %nu 63
%rv = shrink %sh1 %ru shape=[]
%re = load %rv
%j = add %m %u
%ov = shrink %o %j shape=[]
%s2 = store %ov %re
%e2 = end %s2 %u
%eb = end %e1 %e2 %b
%o1 = after %o %eb
