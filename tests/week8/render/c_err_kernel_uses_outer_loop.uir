# cuda: invalid
# a global loop inside a plain loop uses the plain loop's index, which only the CPU knows
%o = buffer 9 dtype=i32 slot=0
%k = range 2
%b = range 2 axis=global
%t = range 4 axis=local
%m2 = mul %b 4
%a = add %m2 %t
%i = add %a %k
%ov = shrink %o %i shape=[]
%st = store %ov %i
%et = end %st %t
%eb = end %et %b
%ek = end %eb %k
%o1 = after %o %ek
