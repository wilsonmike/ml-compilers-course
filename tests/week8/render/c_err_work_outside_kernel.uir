# cuda: invalid
# a load at the top level would run on the CPU: render-cuda needs every bit of work inside a kernel
%x = buffer 4 dtype=f32 slot=0 data=[1.0 2.0 3.0 4.0]
%o = buffer 4 dtype=f32 slot=1
%x0 = shrink %x 0 shape=[]
%s = load %x0
%b = range 1 axis=global
%t = range 4 axis=local
%m = mul %b 4
%i = add %m %t
%ov = shrink %o %i shape=[]
%st = store %ov %s
%et = end %st %t
%eb = end %et %b
%o1 = after %o %eb
