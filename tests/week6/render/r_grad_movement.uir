# render
# a gradient through pad, shrink, permute and expand, rendered as loops
%x  = buffer 6 [1.0 -2.0 0.5 3.0 -1.5 2.25] dtype=f32 slot=0
%o  = buffer 6 dtype=f32 slot=1
%v  = load %x
%m  = reshape %v [2 3]
%p  = pad %m [1 0 0 2]
%s0 = shrink %p 1 1 [2 3]
%t  = permute %s0 [1 0]
%r  = reshape %t [3 2 1]
%e  = expand %r [3 2 4]
%q  = mul %e %e
%f  = reshape %q [24]
%l  = reduce %f op=add
%g  = gradient %l %m
%gf = reshape %g [6]
%s  = store %o %gf
%o1 = after %o %s
