# render
# bitcast both ways. A NaN made by 0 * inf must still come out as 0x7fc00000
%x = buffer 6 dtype=f32 slot=0 data=[1.0 -0.0 inf 0.0 2.5 -3.0]
%y = buffer 6 dtype=i32 slot=1
%z = buffer 6 dtype=f32 slot=2
%v = load %x
%inf = expand inf shape=[6]
%n = mul %v %inf
%b = bitcast %n dtype=i32
%s = store %y %b
%y1 = after %y %s
%f = bitcast %b dtype=f32
%s2 = store %z %f
%z1 = after %z %s2
