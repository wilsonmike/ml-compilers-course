# render
# floor in C, past 2^23 included
%x = buffer 36 dtype=f32 slot=0 data=[-2.5 -0.5 0.5 2.0 1e+10 -1e+10 8388607.5 -8388607.5 inf nan -0.0 0.999999 -2.5 -0.5 0.5 2.0 1e+10 -1e+10 8388607.5 -8388607.5 inf nan -0.0 0.999999 -2.5 -0.5 0.5 2.0 1e+10 -1e+10 8388607.5 -8388607.5 inf nan -0.0 0.999999]
%y = buffer 36 dtype=f32 slot=1
%v = load %x
%r = floor %v
%s = store %y %r
%y1 = after %y %s
