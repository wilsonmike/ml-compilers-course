# test: a digit counts as right when its label's logit is the largest
%tl = load %xt
%tx = reshape %tl shape=[1000 784]
%twl = load %s49_w
%tW = reshape %twl shape=[784 10]
%tz0 = matmul %tx %tW
%tz = stage %tz0
%tzt = permute %tz order=[1 0]
%tm = reduce %tzt op=max
%tyl = load %yt
%tohl = reshape %tyl shape=[1000 1]
%tohe = expand %tohl shape=[1000 10]
%tohc = reshape %classes shape=[1 10]
%tohk = expand %tohc shape=[1000 10]
%tohq = cmpeq %tohe %tohk
%toh = cast %tohq dtype=f32
%tp = mul %tz %toh
%tpt = permute %tp order=[1 0]
%tpick = reduce %tpt op=add          # the label's logit
%tlow = cmplt %tpick %tm
%tyes = expand true shape=[1000]
%thit = xor %tlow %tyes
%tn = cast %thit dtype=i32
%tc = reduce %tn op=add
%okv = shrink %ok 0 shape=[]
%okst = store %okv %tc
%ok1 = after %ok %okst
