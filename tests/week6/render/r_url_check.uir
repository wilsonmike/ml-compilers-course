# render check: slot 1 >= 100
# a threshold test: the sum of a file ramp, stored in slot 1, must reach 100
%x = buffer 64 dtype=f32 slot=0 url=data/ramp.f32 sha256=5fd3b4fd1132866e4c2d23e54c055df469de5738729498241055728a20a9e2c0
%y = buffer 1 dtype=f32 slot=1
%v = load %x
%a = expand 10.0 shape=[64]
%w = add %v %a
%r = reduce %w op=add
%o = shrink %y 0 shape=[]
%s = store %o %r
%y1 = after %y %s
