# render
# scalar math stays loopless C
%x = buffer 4 dtype=f32 slot=0 data=[0.5 -3.0 nan 7.25]
%y = buffer 4 dtype=f32 slot=1
%a0 = shrink %x 0 shape=[]
%l0 = load %a0
%r0 = exp2 %l0
%b0 = shrink %y 0 shape=[]
%s0 = store %b0 %r0
%yv0 = after %y %s0
%a1 = shrink %x 1 shape=[]
%l1 = load %a1
%r1 = log2 %l1
%b1 = shrink %yv0 1 shape=[]
%s1 = store %b1 %r1
%yv1 = after %yv0 %s1
%a2 = shrink %x 2 shape=[]
%l2 = load %a2
%r2 = sqrt %l2
%b2 = shrink %yv1 2 shape=[]
%s2 = store %b2 %r2
%yv2 = after %yv1 %s2
%a3 = shrink %x 3 shape=[]
%l3 = load %a3
%r3 = sin %l3
%b3 = shrink %yv2 3 shape=[]
%s3 = store %b3 %r3
%yv3 = after %yv2 %s3
