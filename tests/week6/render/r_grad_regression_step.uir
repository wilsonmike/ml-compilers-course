# render
# one gradient step of least squares: w -= 0.1 * d/dw mean((Xw - y)^2)
%x = buffer 64 dtype=f32 slot=0 data=[-0.23219159 0.18763839 0.12708783 0.25373912 -0.039129242 -0.45969543 -0.72645366 0.7760966 -0.6149371 -0.10316032 0.61674106 0.15211733 0.8961516 0.61906457 0.027136477 -0.7601764 0.18539308 -0.052609093 0.7235134 0.061592054 0.3885204 0.6232325 -0.05910879 0.6837903 0.7986987 -0.6912998 0.8382992 0.73948795 0.7099932 -0.32447252 -0.4963548 -0.73433846 -0.2580241 0.7100573 -0.27423224 -0.98928785 -0.39015326 -0.83493906 0.24500297 0.5364724 0.8532451 -0.82156265 -0.23919435 -0.74827963 0.8208337 0.6739292 0.039610088 0.9080829 0.04055796 0.55284506 -0.023889603 -0.27147552 0.9888255 0.6834038 0.18336332 0.73445266 0.29888546 0.5955554 -0.8665534 -0.7369998 -0.781183 0.20622769 0.4393161 -0.68976194]
%yb = buffer 16 dtype=f32 slot=1 data=[-0.8266616 0.9600192 0.32979348 -0.7502428 -0.2979205 -0.68350166 0.45592776 0.8334843 -0.6497338 -0.6319351 0.257764 0.7190048 0.47791237 -0.084465645 -0.778976 0.22824644]
%w = buffer 4 dtype=f32 slot=2 data=[0.0051372238 -0.3864037 0.18757054 0.2790277]
%lb = buffer 1 dtype=f32 slot=3
%vx = load %x
%X = reshape %vx shape=[16 4]
%vw = load %w
%Wm = reshape %vw shape=[4 1]
%p = matmul %X %Wm
%pf = reshape %p shape=[16]
%vy = load %yb
%d = sub %pf %vy
%sq = mul %d %d
%ss = reduce %sq op=add
%loss = mul %ss 0.0625
%g = gradient %loss %vw
%lr = expand 0.1 shape=[4]
%st = mul %g %lr
%w1 = sub %vw %st
%s = store %w %w1
%wv = after %w %s
%lv = shrink %lb 0 shape=[]
%s2 = store %lv %loss
%lb1 = after %lb %s2
