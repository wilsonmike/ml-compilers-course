# render
# sin over 64 values, special ones first: your C must match the spec bit for bit
%x = buffer 64 dtype=f32 slot=0 data=[0.0 -0.0 1.0 -1.0 2.0 0.5 8.0 inf -inf nan 1e-45 3.4e+38 128.0 -1.5e+02 2e+02 -2e+02 1e-40 3.0 -2.5 1e+02 27.57898 -10.319227 4.5966263 21.846209 -36.841816 6.43382 36.614887 -28.137474 36.403835 22.282785 41.313877 -19.730158 -48.82385 36.033928 36.57378 -6.57451 -48.746357 -36.340553 16.190262 -25.057972 54.16476 10.628376 -35.89508 18.64848 -16.754452 51.928467 49.141346 1.7581394 17.348618 23.749243 36.66059 57.165 -56.589363 -16.634829 12.209669 -23.481071 10.698809 -49.237503 45.609463 3.031582 -45.98107 19.52894 -22.526321 -36.453102]
%y = buffer 64 dtype=f32 slot=1
%v = load %x
%r = sin %v
%s = store %y %r
%y1 = after %y %s
