# expect: pass
# exp2: inf, -inf, nan, and the clamps at 128 and -150
%xb = buffer 8 dtype=f32 slot=0 data=[inf -inf nan 128.0 -1.5e+02 2e+02 -2e+02 127.99999]
%x = load %xb
%r = exp2 %x
%wb = buffer 8 dtype=f32 slot=1 data=[inf 0.0 nan inf 0.0 inf 0.0 3.4028056e+38]
%w = load %wb
%t = assert %r %w
