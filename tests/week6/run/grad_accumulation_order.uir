# expect: pass
# shares are added in the order they arrive (reverse post-order): here that is 3.3e-08, then 0.7, then 0.1
%sb = buffer 1 dtype=f32 slot=0 data=[1.0]
%sv = shrink %sb 0 shape=[]
%s = load %sv
%a = mul %s 0.1
%b = mul %s 0.7
%c = mul %s 3.3e-08
%ab = add %a %b
%y = add %ab %c
%g = gradient %y %s
%t = assert %g 0.8000001
