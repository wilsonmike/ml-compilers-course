# pad: the gradient is the shrink back to the original window
%xb = buffer 3 [1.0 2.0 3.0] dtype=f32 slot=0
%x  = load %xb
%v  = stage %x
%p  = pad %v [2 1]
%kb = buffer 6 [1e+01 2e+01 3e+01 4e+01 5e+01 6e+01] dtype=f32 slot=2
%k  = load %kb
%q  = mul %p %k
%y  = reduce %q op=add
%g  = gradient %y %v
%gf = reshape %g [3]
%t  = assert %gf [30.0 40.0 50.0]
