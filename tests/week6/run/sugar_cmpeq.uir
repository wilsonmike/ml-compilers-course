# expect: pass
# cmpeq on i32 and on bool
%xb = buffer 4 dtype=i32 slot=0 data=[3 -1 7 -2147483648]
%x = load %xb
%yb = buffer 4 dtype=i32 slot=1 data=[3 1 7 2147483647]
%y = load %yb
%e = cmpeq %x %y
%wb = buffer 4 dtype=bool slot=2 data=[true false true false]
%w = load %wb
%t = assert %e %w
%b = cmpeq false false
%t2 = assert %b true
%c = cmpeq true false
%t3 = assert %c false
