# expect: pass
# sqrt, bit for bit: squares come out exact
%xb = buffer 10 dtype=f32 slot=0 data=[0.0 1.0 4.0 9.0 2.0 0.5 1e-40 3.4e+38 1e+30 0.01]
%x = load %xb
%r = sqrt %x
%wb = buffer 10 dtype=f32 slot=1 data=[0.0 1.0 2.0 3.0 1.4142135 0.70710677 9.999973e-21 1.8439089e+19 1e+15 0.099999994]
%w = load %wb
%t = assert %r %w
