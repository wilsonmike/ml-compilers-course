# sqrt, bit for bit: squares come out exact
%xb = buffer 10 dtype=f32 slot=0 data=[0.0 1.0 4.0 9.0 2.0 0.5 1e-40 3.4e+38 1e+30 0.01]
%x  = load %xb
%r  = sqrt %x
%t  = assert %r [0.0 1.0 2.0 3.0 1.4142135381698608 0.7071067690849304 9.999973025467516e-21 1.8439089273756975e+19 999999986991104.0 0.09999999403953552]
