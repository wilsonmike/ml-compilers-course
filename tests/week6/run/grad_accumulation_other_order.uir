# expect: assert_fail
# adding the same three shares in program order gives different bits
%sb = buffer 1 dtype=f32 slot=0 data=[1.0]
%sv = shrink %sb 0 shape=[]
%s = load %sv
%a = mul %s 0.1
%b = mul %s 0.7
%c = mul %s 3.3e-08
%ab = add %a %b
%y = add %ab %c
%g = gradient %y %s
%t = assert %g 0.80000013
