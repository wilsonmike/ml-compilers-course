# expect: pass
# exp2 below -126 lands in the subnormals: 2^h * 2^k keeps it right
%xb = buffer 6 dtype=f32 slot=0 data=[-126.5 -130.25 -140.75 -148.5 -149.4 -149.6]
%x = load %xb
%r = exp2 %x
%wb = buffer 6 dtype=f32 slot=1 data=[8.312001e-39 6.17793e-40 4.26e-43 1e-45 1e-45 1e-45]
%w = load %wb
%t = assert %r %w
