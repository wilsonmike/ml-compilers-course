# expect: pass
# exp2 of fractions, bit for bit: the exact steps of the spec
%xb = buffer 8 dtype=f32 slot=0 data=[0.5 0.1 -2.7 3.3 -0.25 12.345 -100.5 0.001]
%x = load %xb
%r = exp2 %x
%wb = buffer 8 dtype=f32 slot=1 data=[1.4142135 1.0717734 0.15389305 9.849155 0.8408964 5202.5396 5.578089e-31 1.0006934]
%w = load %wb
%t = assert %r %w
