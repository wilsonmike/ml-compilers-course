# expect: pass
# a math op inside a hand-written loop: 2^0 + 2^1 + 2^2 + 2^3
%acc = alloc 1 dtype=f32
%k = range 4
%a = shrink %acc 0 shape=[]
%cur = load %a
%kf = cast %k dtype=f32
%p = exp2 %kf
%sum = add %cur %p
%s = store %a %sum
%e = end %s %k
%acc1 = after %acc %e
%r = shrink %acc1 0 shape=[]
%v = load %r
%t = assert %v 15.0
