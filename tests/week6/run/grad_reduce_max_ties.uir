# expect: pass
# reduce max: the gradient is split between tied maxima
%xb = buffer 4 dtype=f32 slot=0 data=[1.0 5.0 5.0 2.0]
%x = load %xb
%v = stage %x
%y = reduce %v op=max
%g = gradient %y %v
%gf = reshape %g shape=[4]
%wb = buffer 4 dtype=f32 slot=1 data=[0.0 0.5 0.5 0.0]
%w = load %wb
%t = assert %gf %w
