# expect: pass
# floor: halves, negatives, values past 2^23, inf and nan
%xb = buffer 14 dtype=f32 slot=0 data=[-2.5 -0.5 0.5 2.0 -2.0 1e+10 -1e+10 8388607.5 -8388607.5 inf -inf nan 0.999999 -1e-45]
%x = load %xb
%r = floor %x
%wb = buffer 14 dtype=f32 slot=1 data=[-3.0 -1.0 0.0 2.0 -2.0 1e+10 -1e+10 8388607.0 -8388608.0 inf -inf nan 0.0 -1.0]
%w = load %wb
%t = assert %r %w
