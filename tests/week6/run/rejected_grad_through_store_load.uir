# a store and a load on the path: memory is not differentiable
%sb  = buffer 1 [3.0] dtype=f32 slot=0
%sv  = shrink %sb 0 []
%s   = load %sv
%m   = alloc 1 dtype=f32
%mv  = shrink %m 0 []
%st  = store %mv %s
%m1  = after %m %st
%mv1 = shrink %m1 0 []
%l   = load %mv1
%y   = mul %l %l
%g   = gradient %y %s
