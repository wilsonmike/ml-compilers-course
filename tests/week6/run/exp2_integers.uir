# expect: pass
# exp2 of an integer n is exactly 2^n, down into the subnormals
%xb = buffer 8 dtype=f32 slot=0 data=[0.0 1.0 -1.0 1e+01 -1e+01 127.0 -126.0 -149.0]
%x = load %xb
%r = exp2 %x
%wb = buffer 8 dtype=f32 slot=1 data=[1.0 2.0 0.5 1024.0 0.0009765625 1.7014118e+38 1.1754944e-38 1e-45]
%w = load %wb
%t = assert %r %w
