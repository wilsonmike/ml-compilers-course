# expect: pass
# a reduce op=mul that x does not reach is fine
%xb = buffer 3 dtype=f32 slot=0 data=[1.0 2.0 3.0]
%x = load %xb
%v = stage %x
%p = reduce %x op=mul
%s = reduce %v op=add
%y = mul %s %p
%g = gradient %y %v
%wb = buffer 3 dtype=f32 slot=1 data=[6.0 6.0 6.0]
%w = load %wb
%t = assert %g %w
