# expect: pass
# expand of a scalar: its gradient sums every copy
%xb = buffer 1 dtype=f32 slot=0 data=[3.0]
%x = load %xb
%v = stage %x
%s = reshape %v shape=[]
%e = expand %s shape=[2 3]
%q = mul %e %e
%f = reshape %q shape=[6]
%y = reduce %f op=add
%g = gradient %y %s
%gf = reshape %g shape=[1]
%wb = buffer 1 dtype=f32 slot=1 data=[36.0]
%w = load %wb
%t = assert %gf %w
