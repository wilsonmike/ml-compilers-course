# expect: pass
# log2 of a power of two is exact, subnormals included
%xb = buffer 8 dtype=f32 slot=0 data=[1.0 2.0 8.0 0.5 1024.0 1.1754944e-38 1e-45 1.7014118e+38]
%x = load %xb
%r = log2 %x
%wb = buffer 8 dtype=f32 slot=1 data=[0.0 1.0 3.0 -1.0 1e+01 -126.0 -149.0 127.0]
%w = load %wb
%t = assert %r %w
