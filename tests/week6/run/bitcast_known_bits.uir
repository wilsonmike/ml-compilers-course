# expect: pass
# bitcast reads the same 32 bits as the other type
%a = bitcast 1.0 dtype=i32
%t1 = assert %a 1065353216
%b = bitcast -0.0 dtype=i32
%t2 = assert %b -2147483648
%c = bitcast -2.0 dtype=i32
%t3 = assert %c -1073741824
%d = bitcast inf dtype=i32
%t4 = assert %d 2139095040
%e = bitcast 1 dtype=f32
%t5 = assert %e 1.4e-45
