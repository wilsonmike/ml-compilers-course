# the gradient of a log-softmax loss is softmax minus one-hot
%xb   = buffer 4 [0.5 -1.0 2.0 0.25] dtype=f32 slot=0
%x    = load %xb
%v    = stage %x
%m    = reduce %v op=max
%md   = detach %m
%me   = expand %md [4]
%z    = sub %v %me
%e    = exp %z
%s    = reduce %e op=add
%ls   = log %s
%pick = shrink %z 2 [1]
%pr   = reshape %pick []
%lp   = sub %pr %ls
%y    = neg %lp
%g    = gradient %y %v
%gf   = reshape %g [4]
%t    = assert %gf [0.15423481166362762 0.034414444118738174 -0.30876749753952026 0.12011819332838058]
