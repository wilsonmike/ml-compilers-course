# a longer chain: sigmoid written with exp, fdiv and add
%xb  = buffer 4 [-2.0 -0.5 0.0 1.5] dtype=f32 slot=0
%x   = load %xb
%v   = stage %x
%n   = neg %v
%e   = exp %n
%one = expand 1.0 [4]
%d   = add %one %e
%sg  = fdiv %one %d
%y   = reduce %sg op=add
%g   = gradient %y %v
%gf  = reshape %g [4]
%t   = assert %gf [0.10499360412359238 0.23500370979309082 0.25 0.1491464376449585]
