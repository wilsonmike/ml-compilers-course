# expect: pass
# a thread loop inside a plain loop: each pass of the outer loop runs it again
%o = buffer 4 dtype=i32 slot=0
%k = range 3
%r = range 4 axis=thread
%v = shrink %o %r shape=[]
%cur = load %v
%rk = add %r %k
%n = add %cur %rk
%s = store %v %n
%er = end %s %r
%ek = end %er %k
%o1 = after %o %ek
%l = load %o1
%w = stack 3 6 9 12
%t = assert %l %w
