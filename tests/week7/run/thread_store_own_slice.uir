# expect: pass
# iteration r writes o[4r + j], j in [0, 3]: its own slice
%o = buffer 16 dtype=i32 slot=0
%r = range 4 axis=thread
%j = range 4
%m = mul %r 4
%off = add %m %j
%v = shrink %o %off shape=[]
%s = store %v 1
%ej = end %s %j
%e = end %ej %r
%o1 = after %o %e
%l = load %o1
%w = expand 1 shape=[16]
%t = assert %l %w
