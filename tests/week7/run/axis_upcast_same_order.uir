# upcast unrolls but keeps the order: the f32 sum (with 1e8 and -1e8 in it) has the same bits
%x    = buffer 8 [0.5 1.5 -2.0 3.25 1e8 -1e8 0.1 7.0] dtype=f32 slot=0
%acc  = alloc 1 dtype=f32
%u    = range 8 axis=upcast
%a    = shrink %acc 0 []
%cur  = load %a
%xv   = shrink %x %u []
%xe   = load %xv
%s    = add %cur %xe
%st   = store %a %s
%e    = end %st %u
%acc1 = after %acc %e
%r    = shrink %acc1 0 []
%v    = load %r
%t    = assert %v 7.099999904632568
