# expect: invalid
# a thread loop inside another thread loop, even when each access rule holds (the outer loop runs once)
%o = buffer 4 dtype=i32 slot=0
%r = range 1 axis=thread
%j = range 4 axis=thread
%m = mul %r 4
%off = add %m %j
%v = shrink %o %off shape=[]
%s = store %v 1
%ej = end %s %j
%e = end %ej %r
%o1 = after %o %e
