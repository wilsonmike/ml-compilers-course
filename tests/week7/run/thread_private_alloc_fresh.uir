# expect: pass
# an alloc used only inside a thread loop starts at zero in every iteration: out[r] = 0 + r
%o = buffer 4 dtype=i32 slot=0
%acc = alloc 1 dtype=i32
%r = range 4 axis=thread
%a = shrink %acc 0 shape=[]
%cur = load %a
%n = add %cur %r
%st = store %a %n
%acc1 = after %acc %st
%a1 = shrink %acc1 0 shape=[]
%got = load %a1
%ov = shrink %o %r shape=[]
%so = store %ov %got
%e = end %st %so %r
%o1 = after %o %e
%l = load %o1
%w = stack 0 1 2 3
%t = assert %l %w
