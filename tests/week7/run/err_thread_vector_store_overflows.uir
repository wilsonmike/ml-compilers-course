# expect: invalid
# a 2-element store at 4r + j, j up to 3, spills into the next slice
%o = buffer 18 dtype=i32 slot=0
%r = range 4 axis=thread
%j = range 4
%m = mul %r 4
%off = add %m %j
%v = shrink %o %off shape=[2]
%val = stack 1 1
%s = store %v %val
%ej = end %s %j
%e = end %ej %r
%o1 = after %o %e
