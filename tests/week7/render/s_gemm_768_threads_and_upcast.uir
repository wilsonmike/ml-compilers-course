# speed: 0.5
# max_bytes: 80000
# time: 60
# the full schedule: at least half the reference's speed. Ignoring the thread axis is about 8 times too slow.
%A = buffer 589824 dtype=f32 slot=0 url=data/a768.f32 sha256=adbdb064138354ba6817080a8d25696c5e0a8ceb9fb99caad3c3bcbe5310f1b8
%B = buffer 589824 dtype=f32 slot=1 url=data/b768.f32 sha256=481612a2428ee8721106a9723dd605fd54cbe074d4e8b251473c27ac144a0d5b
%C = buffer 589824 dtype=f32 slot=2
%acc = alloc 32 dtype=f32
%ib = range 192 axis=thread
%jb = range 96
# start each tile from its first product, A[i][0] * B[0][j], like reduce's fold
%ri = range 4 axis=upcast
%rj = range 8 axis=upcast
%ri0 = mul %ib 4
%rii = add %ri0 %ri
%rar = mul %rii 768
%rav = shrink %A %rar shape=[]
%ra = load %rav
%rj0 = mul %jb 8
%rjj = add %rj0 %rj
%rbv = shrink %B %rjj shape=[]
%rb = load %rbv
%ro0 = mul %ri 8
%ro = add %ro0 %rj
%rv = shrink %acc %ro shape=[]
%rp = mul %ra %rb
%rs = store %rv %rp
%re1 = end %rs %rj
%re2 = end %re1 %ri
%acc1 = after %acc %re2
# then k = 1, 2, ..., K-1, in order
%k0 = range 767
%k = add %k0 1
%ki = range 4 axis=upcast
%kj = range 8 axis=upcast
%i0 = mul %ib 4
%i = add %i0 %ki
%ar = mul %i 768
%ao = add %ar %k
%av = shrink %A %ao shape=[]
%a = load %av
%j0 = mul %jb 8
%j = add %j0 %kj
%br = mul %k 768
%bo = add %br %j
%bv = shrink %B %bo shape=[]
%b = load %bv
%co0 = mul %ki 8
%co = add %co0 %kj
%cv = shrink %acc1 %co shape=[]
%cur = load %cv
%p = mul %a %b
%sum = add %cur %p
%st = store %cv %sum
%ke1 = end %st %kj
%ke2 = end %ke1 %ki
%ke3 = end %ke2 %k0
%acc2 = after %acc1 %ke3
# write the tile out: C[(ib*TI + wi)*N + jb*TJ + wj], written as ib*(TI*N) + the rest
%wi = range 4 axis=upcast
%wj = range 8 axis=upcast
%wo0 = mul %wi 8
%wo = add %wo0 %wj
%wv = shrink %acc2 %wo shape=[]
%w = load %wv
%o1 = mul %ib 3072
%o2 = mul %wi 768
%o3 = mul %jb 8
%o4 = add %o2 %o3
%o5 = add %o4 %wj
%oo = add %o1 %o5
%ov = shrink %C %oo shape=[]
%os = store %ov %w
%we1 = end %os %wj
%we2 = end %we1 %wi
%je = end %re2 %ke3 %we2 %jb
%ie = end %je %ib
%C1 = after %C %ie
