# render
# max_bytes: 80000
# a 8x16 by 5 GEMM: thread over 4-row blocks, a 4x8 private tile, upcast loops. Same bits as matmul.
%A = buffer 40 dtype=f32 slot=0 data=[-0.4408339262008667 -0.08144205063581467 0.09446148574352264 -0.7969987988471985 0.004429660737514496 0.9127402305603027 0.12536267936229706 0.037745505571365356 0.5798609256744385 -0.09803701192140579 -0.4496248662471771 0.6779335141181946 -0.6658239960670471 0.778503954410553 0.7670669555664062 0.09618768095970154 0.03273482993245125 -0.8686873316764832 -0.6534311771392822 0.5449182391166687 0.45748257637023926 0.24470090866088867 -0.725374698638916 0.44837069511413574 0.9785552024841309 0.7439465522766113 0.33133554458618164 -0.1088293045759201 -0.15257851779460907 -0.6933266520500183 -0.9182323217391968 0.935651957988739 -0.20649419724941254 -0.22190582752227783 -0.03187789022922516 0.9664125442504883 0.8283344507217407 0.37975290417671204 0.568013072013855 0.052206628024578094]
%B = buffer 80 dtype=f32 slot=1 data=[0.29741260409355164 0.5917016267776489 0.3292808532714844 -0.9020222425460815 -0.06938036531209946 0.17217545211315155 0.34378349781036377 0.8631210327148438 0.5651873350143433 -0.16308487951755524 -0.04206952080130577 0.5609309673309326 0.5134217143058777 -0.2781732380390167 -0.206801176071167 0.22336432337760925 -0.01091526448726654 0.3366703391075134 0.7093618512153625 -0.16470178961753845 0.15737488865852356 -0.5995690226554871 0.6265480518341064 0.39702317118644714 0.21022886037826538 -0.32322317361831665 -0.8215408325195312 -0.5005894303321838 -0.4751497209072113 0.5364626049995422 0.1528410017490387 0.7082467675209045 0.8597607016563416 -0.46280747652053833 -0.6929435133934021 0.4491037130355835 -0.14524812996387482 0.6635847091674805 -0.10675107687711716 -0.5430424213409424 0.8879191279411316 0.4894968271255493 0.5956873297691345 0.4103465974330902 0.9021039009094238 0.7534680962562561 -0.8638644218444824 -0.845352292060852 -0.917217493057251 0.4872661232948303 -0.002524562878534198 0.41975319385528564 -0.8057172894477844 -0.6478928923606873 0.7621847987174988 0.24460598826408386 -0.6917057633399963 -0.7604243755340576 0.6008105278015137 0.6787673234939575 -0.771891713142395 0.9594730138778687 -0.7568902969360352 -0.21923503279685974 0.24660973250865936 0.6244127750396729 0.7540859580039978 -0.959738552570343 -0.4947117567062378 -0.723528265953064 -0.8455287218093872 0.34090656042099 -0.7152253985404968 -0.1607017070055008 0.36021921038627625 0.5549079179763794 0.07692345976829529 0.3818173110485077 0.302336722612381 -0.5402126908302307]
%C = buffer 128 dtype=f32 slot=2
%acc = alloc 32 dtype=f32
%ib = range 2 axis=thread
%jb = range 2
# start each tile from its first product, A[i][0] * B[0][j], like reduce's fold
%ri = range 4 axis=upcast
%rj = range 8 axis=upcast
%ri0 = mul %ib 4
%rii = add %ri0 %ri
%rar = mul %rii 5
%rav = shrink %A %rar shape=[]
%ra = load %rav
%rj0 = mul %jb 8
%rjj = add %rj0 %rj
%rbv = shrink %B %rjj shape=[]
%rb = load %rbv
%ro0 = mul %ri 8
%ro = add %ro0 %rj
%rv = shrink %acc %ro shape=[]
%rp = mul %ra %rb
%rs = store %rv %rp
%re1 = end %rs %rj
%re2 = end %re1 %ri
%acc1 = after %acc %re2
# then k = 1, 2, ..., K-1, in order
%k0 = range 4
%k = add %k0 1
%ki = range 4 axis=upcast
%kj = range 8 axis=upcast
%i0 = mul %ib 4
%i = add %i0 %ki
%ar = mul %i 5
%ao = add %ar %k
%av = shrink %A %ao shape=[]
%a = load %av
%j0 = mul %jb 8
%j = add %j0 %kj
%br = mul %k 16
%bo = add %br %j
%bv = shrink %B %bo shape=[]
%b = load %bv
%co0 = mul %ki 8
%co = add %co0 %kj
%cv = shrink %acc1 %co shape=[]
%cur = load %cv
%p = mul %a %b
%sum = add %cur %p
%st = store %cv %sum
%ke1 = end %st %kj
%ke2 = end %ke1 %ki
%ke3 = end %ke2 %k0
%acc2 = after %acc1 %ke3
# write the tile out: C[(ib*TI + wi)*N + jb*TJ + wj], written as ib*(TI*N) + the rest
%wi = range 4 axis=upcast
%wj = range 8 axis=upcast
%wo0 = mul %wi 8
%wo = add %wo0 %wj
%wv = shrink %acc2 %wo shape=[]
%w = load %wv
%o1 = mul %ib 64
%o2 = mul %wi 16
%o3 = mul %jb 8
%o4 = add %o2 %o3
%o5 = add %o4 %wj
%oo = add %o1 %o5
%ov = shrink %C %oo shape=[]
%os = store %ov %w
%we1 = end %os %wj
%we2 = end %we1 %wi
%je = end %re2 %ke3 %we2 %jb
%ie = end %je %ib
%C1 = after %C %ie
