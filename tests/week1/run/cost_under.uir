# each level calls the one below twice, through two different call nodes (one has an extra argument).
# A call costs 1 plus its body, so the static cost doubles per level: 16 levels cost 393,213
%x = param [] slot=0 dtype=i32 addrspace=ALU
%f0 = add %x 1
%a1 = call %f0 %x
%b1 = call %f0 %x 0
%f1 = add %a1 %b1
%a2 = call %f1 %x
%b2 = call %f1 %x 0
%f2 = add %a2 %b2
%a3 = call %f2 %x
%b3 = call %f2 %x 0
%f3 = add %a3 %b3
%a4 = call %f3 %x
%b4 = call %f3 %x 0
%f4 = add %a4 %b4
%a5 = call %f4 %x
%b5 = call %f4 %x 0
%f5 = add %a5 %b5
%a6 = call %f5 %x
%b6 = call %f5 %x 0
%f6 = add %a6 %b6
%a7 = call %f6 %x
%b7 = call %f6 %x 0
%f7 = add %a7 %b7
%a8 = call %f7 %x
%b8 = call %f7 %x 0
%f8 = add %a8 %b8
%a9 = call %f8 %x
%b9 = call %f8 %x 0
%f9 = add %a9 %b9
%a10 = call %f9 %x
%b10 = call %f9 %x 0
%f10 = add %a10 %b10
%a11 = call %f10 %x
%b11 = call %f10 %x 0
%f11 = add %a11 %b11
%a12 = call %f11 %x
%b12 = call %f11 %x 0
%f12 = add %a12 %b12
%a13 = call %f12 %x
%b13 = call %f12 %x 0
%f13 = add %a13 %b13
%a14 = call %f13 %x
%b14 = call %f13 %x 0
%f14 = add %a14 %b14
%a15 = call %f14 %x
%b15 = call %f14 %x 0
%f15 = add %a15 %b15
%a16 = call %f15 %x
%b16 = call %f15 %x 0
%f16 = add %a16 %b16
%r = call %f16 1
%t = assert %r 131072
