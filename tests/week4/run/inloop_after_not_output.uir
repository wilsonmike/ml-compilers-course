# expect: pass
# an after inside a loop is local to an iteration, not an output: no top-level after builds on %b, so %b's output is unchanged
%b = buffer 3 dtype=i32 slot=0 data=[1 2 3]
%i = range 3
%bv = shrink %b %i shape=[]
%z = store %bv 9
%b1 = after %b %z
%e = end %z %i
%all = load %b
%ea = stack 1 2 3
%t = assert %all %ea
