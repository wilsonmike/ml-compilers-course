# expect: pass
# a reduce result (no open ranges) used inside a week 3 loop
%x = stack 1 2 3
%s = reduce %x op=add
%b = buffer 3 dtype=i32 slot=0
%i = range 3
%v = add %s %i
%bv = shrink %b %i shape=[]
%st = store %bv %v
%e = end %st %i
%b1 = after %b %e
%all = load %b1
%ea = stack 6 7 8
%t = assert %all %ea
