# expect: pass
# mean, then variance from the deviations
%x = stack 2.0 4.0 4.0 4.0 5.0 5.0 7.0 9.0
%s = reduce %x op=add
%m = mul %s 0.125
%mn = mul %m -1.0
%nm = expand %mn shape=[8]
%d = add %x %nm
%sq = mul %d %d
%ss = reduce %sq op=add
%v = mul %ss 0.125
%t0 = assert %m 5.0
%t1 = assert %v 4.0
