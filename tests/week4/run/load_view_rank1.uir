# expect: pass
# load a [k] view, add an expanded scalar, store into another buffer's view
%b = buffer 6 dtype=i32 slot=0 data=[1 2 3 4 5 6]
%c = buffer 4 dtype=i32 slot=1
%v = shrink %b 2 shape=[3]
%x = load %v
%e = expand 100 shape=[3]
%y = add %x %e
%cv = shrink %c 1 shape=[3]
%s = store %cv %y
%c1 = after %c %s
%all = load %c1
%ea = stack 0 103 104 105
%t = assert %all %ea
