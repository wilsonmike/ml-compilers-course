# expect: pass
# cmplt gives a bool vector, and where selects per element
%x = stack 1.0 nan -2.0 0.0
%z = expand 0.0 shape=[4]
%c = cmplt %x %z
%ec = stack false false true false
%t0 = assert %c %ec
%mone = expand -1.0 shape=[4]
%n = mul %x %mone
%w = where %c %n %x
%ew = stack 1.0 nan 2.0 0.0
%t1 = assert %w %ew
