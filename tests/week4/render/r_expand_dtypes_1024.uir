# render
# expand i32, f32 and bool scalars into buffers
%a = buffer 1024 dtype=i32 slot=0
%b = buffer 1024 dtype=f32 slot=1
%c = buffer 1024 dtype=bool slot=2
%ea = expand -7 shape=[1024]
%s1 = store %a %ea
%a1 = after %a %s1
%eb = expand -0.0 shape=[1024]
%s2 = store %b %eb
%b1 = after %b %s2
%ec = expand true shape=[1024]
%s3 = store %c %ec
%c1 = after %c %s3
