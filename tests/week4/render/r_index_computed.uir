# render
# index into a computed vector at a loaded, masked index
%x = buffer 4 dtype=i32 slot=0 data=[5 6 7 8]
%k = buffer 1 dtype=i32 slot=1 data=[6]
%y = buffer 1 dtype=i32 slot=2
%v = load %x
%w = mul %v %v
%kv = shrink %k 0 shape=[]
%kk = load %kv
%m0 = max %kk 0
%m = mod %m0 4
%e = index %w %m
%yv = shrink %y 0 shape=[]
%st = store %yv %e
%y1 = after %y %st
