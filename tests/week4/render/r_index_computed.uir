# render
# index into a computed vector at a loaded, masked index
%x  = buffer 4 [5 6 7 8] dtype=i32 slot=0
%k  = buffer 1 [6] dtype=i32 slot=1
%y  = buffer 1 dtype=i32 slot=2
%v  = load %x
%w  = mul %v %v
%kv = shrink %k 0 []
%kk = load %kv
%m0 = max %kk 0
%m  = mod %m0 4
%e  = index %w %m
%yv = shrink %y 0 []
%st = store %yv %e
%y1 = after %y %st
