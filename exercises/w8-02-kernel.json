{
  "id": "w8-02-kernel",
  "lang": "uir",
  "mode": "buffers",
  "out_slot": 1,
  "title": "Loops into a kernel",
  "require": [
    [
      "%b = range 4 axis=global",
      "make %b the global loop: one block per iteration"
    ],
    [
      "%t = range 16 axis=local",
      "make %t the local loop: one thread per iteration"
    ]
  ],
  "starter": "%x = buffer 64 dtype=f32 slot=0\n%o = buffer 64 dtype=f32 slot=1\n# o = 3x + 1 for 64 elements, as 4 blocks of 16 threads. Make %b the blocks and %t the threads.\n%b = range 4\n%t = range 16\n%m = mul %b 16\n%i = add %m %t\n%xv = shrink %x %i shape=[]\n%xe = load %xv\n%y = mul %xe 3.0\n%z = add %y 1.0\n%ov = shrink %o %i shape=[]\n%s = store %ov %z\n%et = end %s %t\n%eb = end %et %b\n%o1 = after %o %eb\n",
