{
  "id": "w7-06-schedule-gemm",
  "lang": "uir",
  "mode": "buffers",
  "out_slot": 2,
  "title": "Schedule a GEMM",
  "require": [
    [
      "%ib = range \\d+ axis=thread",
      "make the row-block loop %ib a thread loop"
    ],
    [
      "%ri = range \\d+ axis=upcast",
      "make %ri an upcast loop (all six tile loops: %ri, %rj, %ki, %kj, %wi, %wj)"
    ],
    [
      "%rj = range \\d+ axis=upcast",
      "make %rj an upcast loop (all six tile loops: %ri, %rj, %ki, %kj, %wi, %wj)"
    ],
    [
      "%ki = range \\d+ axis=upcast",
      "make %ki an upcast loop (all six tile loops: %ri, %rj, %ki, %kj, %wi, %wj)"
    ],
    [
      "%kj = range \\d+ axis=upcast",
      "make %kj an upcast loop (all six tile loops: %ri, %rj, %ki, %kj, %wi, %wj)"
    ],
    [
      "%wi = range \\d+ axis=upcast",
      "make %wi an upcast loop (all six tile loops: %ri, %rj, %ki, %kj, %wi, %wj)"
    ],
    [
      "%wj = range \\d+ axis=upcast",
      "make %wj an upcast loop (all six tile loops: %ri, %rj, %ki, %kj, %wi, %wj)"
    ]
  ],
  "starter": "# C = A @ B for an 8x5 A and a 5x16 B, with a 4x8 tile. Make %ib a thread loop and the six tile loops upcast loops.\n%A = buffer 40 dtype=f32 slot=0\n%B = buffer 80 dtype=f32 slot=1\n%C = buffer 128 dtype=f32 slot=2\n%acc = alloc 32 dtype=f32\n%ib = range 2\n%jb = range 2\n# start each tile from its first product, A[i][0] * B[0][j], like reduce's fold\n%ri = range 4\n%rj = range 8\n%ri0 = mul %ib 4\n%rii = add %ri0 %ri\n%rar = mul %rii 5\n%rav = shrink %A %rar shape=[]\n%ra = load %rav\n%rj0 = mul %jb 8\n%rjj = add %rj0 %rj\n%rbv = shrink %B %rjj shape=[]\n%rb = load %rbv\n%ro0 = mul %ri 8\n%ro = add %ro0 %rj\n%rv = shrink %acc %ro shape=[]\n%rp = mul %ra %rb\n%rs = store %rv %rp\n%re1 = end %rs %rj\n%re2 = end %re1 %ri\n%acc1 = after %acc %re2\n# then k = 1, 2, ..., K-1, in order\n%k0 = range 4\n%k = add %k0 1\n%ki = range 4\n%kj = range 8\n%i0 = mul %ib 4\n%i = add %i0 %ki\n%ar = mul %i 5\n%ao = add %ar %k\n%av = shrink %A %ao shape=[]\n%a = load %av\n%j0 = mul %jb 8\n%j = add %j0 %kj\n%br = mul %k 16\n%bo = add %br %j\n%bv = shrink %B %bo shape=[]\n%b = load %bv\n%co0 = mul %ki 8\n%co = add %co0 %kj\n%cv = shrink %acc1 %co shape=[]\n%cur = load %cv\n%p = mul %a %b\n%sum = add %cur %p\n%st = store %cv %sum\n%ke1 = end %st %kj\n%ke2 = end %ke1 %ki\n%ke3 = end %ke2 %k0\n%acc2 = after %acc1 %ke3\n# write the tile out: C[(ib*TI + wi)*N + jb*TJ + wj], written as ib*(TI*N) + the rest\n%wi = range 4\n%wj = range 8\n%wo0 = mul %wi 8\n%wo = add %wo0 %wj\n%wv = shrink %acc2 %wo shape=[]\n%w = load %wv\n%o1 = mul %ib 64\n%o2 = mul %wi 16\n%o3 = mul %jb 8\n%o4 = add %o2 %o3\n%o5 = add %o4 %wj\n%oo = add %o1 %o5\n%ov = shrink %C %oo shape=[]\n%os = store %ov %w\n%we1 = end %os %wj\n%we2 = end %we1 %wi\n%je = end %re2 %ke3 %we2 %jb\n%ie = end %je %ib\n%C1 = after %C %ie\n",
